  </asp:Panel>

  <asp:Panel ID="AddNotice" runat="server" Visible="false" CssClass="am-note am-note-info" role="note"><svg class="am-note-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 11v6M12 7.5v.5"/></svg>Login access and invitation can be managed after saving the employee.</asp:Panel>
  <asp:Panel ID="InfoSection" runat="server" CssClass="am-section am-banded am-info-v4"><div class="am-band"><h2><svg class="am-sec-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4.5"/><path d="M3 22c0-5 4-8 9-8s9 3 9 8z"/></svg>Employee Information</h2></div><div class="am-grid am-cols-4">
   <label class="am-field am-o-fn"><span>First Name <span class="am-req">(Required)</span></span><asp:TextBox ID="FirstName" runat="server" MaxLength="50" placeholder="Enter first name" /></label>
   <label class="am-field am-o-ln"><span>Last Name <span class="am-req">(Required)</span></span><asp:TextBox ID="LastName" runat="server" MaxLength="50" placeholder="Enter last name" /></label>
   <label class="am-field am-o-em"><span>Email <span class="am-hint">(To grant online access)</span></span><asp:TextBox ID="Email" runat="server" TextMode="Email" MaxLength="100" placeholder="Enter email address" /></label>
   <label class="am-field am-o-ph"><span>Contact Phone <span class="am-req">(Required)</span></span><span class="am-phone"><span class="am-phone-cc" title="Canada +1"><svg class="am-flag" viewBox="0 0 24 12" aria-hidden="true"><rect width="6" height="12" fill="#d52b1e"/><rect x="6" width="12" height="12" fill="#fff"/><rect x="18" width="6" height="12" fill="#d52b1e"/><path d="M12 2.2l1 1.9 1.2-.5-.4 2.4 1.4-.9.3.8 1.2-.2-.6 1.3.7.4-2.6 1.6.2.9-2.2-.3V11h-.4V9.6l-2.2.3.2-.9L6.6 7.4l.7-.4-.6-1.3 1.2.2.3-.8 1.4.9-.4-2.4 1.2.5z" fill="#d52b1e"/></svg><b>+1</b><i class="am-chev" aria-hidden="true"></i></span><asp:TextBox ID="Phone" runat="server" TextMode="Phone" MaxLength="20" placeholder="(416) 555-1234" /></span></label>
   <label class="am-field am-o-mo"><span>Mobile <span class="am-hint">(Optional)</span></span><span class="am-phone"><span class="am-phone-cc" title="Canada +1"><svg class="am-flag" viewBox="0 0 24 12" aria-hidden="true"><rect width="6" height="12" fill="#d52b1e"/><rect x="6" width="12" height="12" fill="#fff"/><rect x="18" width="6" height="12" fill="#d52b1e"/><path d="M12 2.2l1 1.9 1.2-.5-.4 2.4 1.4-.9.3.8 1.2-.2-.6 1.3.7.4-2.6 1.6.2.9-2.2-.3V11h-.4V9.6l-2.2.3.2-.9L6.6 7.4l.7-.4-.6-1.3 1.2.2.3-.8 1.4.9-.4-2.4 1.2.5z" fill="#d52b1e"/></svg><b>+1</b><i class="am-chev" aria-hidden="true"></i></span><asp:TextBox ID="Mobile" runat="server" TextMode="Phone" MaxLength="20" placeholder="(416) 555-1234" /></span></label>
   <label class="am-field am-o-dob"><span>Date of Birth <span class="am-hint">(Optional)</span></span><asp:TextBox ID="DateOfBirth" runat="server" TextMode="Date" /></label>
   <label class="am-field am-o-gen"><span>Gender</span><asp:DropDownList ID="Gender" runat="server"><asp:ListItem Value="">Select</asp:ListItem><asp:ListItem>Male</asp:ListItem><asp:ListItem>Female</asp:ListItem><asp:ListItem>Other</asp:ListItem></asp:DropDownList></label>
   <label class="am-field am-o-sin"><span>SIN Number</span><asp:TextBox ID="Sin" runat="server" MaxLength="11" autocomplete="off" placeholder="### ### ###" /></label>
   <label class="am-field am-o-hire"><span>Hire Date <span class="am-req">(Required)</span></span><asp:TextBox ID="HireDate" runat="server" TextMode="Date" /><span class="am-req am-small am-add-only">* Hire Date cannot be changed or edited.</span></label>
   <label class="am-field am-o-sinx"><span>SIN Expiry Date <span class="am-hint">(If Any)</span></span><asp:TextBox ID="SinExpiry" runat="server" TextMode="Date" /></label>
   <label class="am-field am-o-st"><span>Employee Status <span class="am-req">(Required)</span></span><asp:DropDownList ID="Status" runat="server"><asp:ListItem>Active</asp:ListItem><asp:ListItem>Not Active</asp:ListItem><asp:ListItem>Terminated</asp:ListItem></asp:DropDownList></label>
   <label class="am-field am-o-mn"><span>Middle Name <span class="am-hint">(Optional)</span></span><asp:TextBox ID="MiddleName" runat="server" MaxLength="50" placeholder="Enter middle name" /></label>
  </div></asp:Panel>

  <%-- 2026-11-01 v46 (Paused deck s2/s4 "I want same look below - Not the employee one"): the Business / Subscriber Address
       Lookup look (Country with flag, Postal / ZIP Code with clear, Search Address, Enter Address Manually, hint, Address Not
       Found card, Select Address from Search Results) and the Address Details card. Server IDs unchanged. --%>
  <div class="am-emp-al am-emp-al46" id="amEmpAddress">
  <asp:Panel ID="LookupSection" runat="server" CssClass="am-al-layout am-al-single" DefaultButton="SearchPostal">
   <section class="am-al-main" aria-labelledby="amEmpLookupHead">
   <h2 id="amEmpLookupHead">Address Lookup</h2>
   <p class="am-al-sub">Search for an address using a postal or ZIP code, select a result, or enter the address manually.</p>
   <div class="am-al-search">
    <div class="am-al-f am-al-country"><label for="amEmpLookupCountry">Country <b class="am-al-req">*</b></label><span class="am-al-flagsel"><span class="am-al-flag" id="amEmpLookupFlag"><svg class="am-flag-ca" viewBox="0 0 24 16" width="24" height="16" aria-hidden="true" focusable="false"><rect width="24" height="16" fill="#fff"/><rect width="6" height="16" fill="#d52b1e"/><rect x="18" width="6" height="16" fill="#d52b1e"/><path d="M12 3.2l1 2.1 1.3-.6-.4 2.6 1.4-1.3.4 1-1.2 1.1h1.1L15 9.5l.9.5-3.4.6V13h-1V10.6l-3.4-.6.9-.5-.6-1.4h1.1L8.3 7l.4-1 1.4 1.3-.4-2.6 1.3.6z" fill="#d52b1e"/></svg> <svg class="am-flag-us" viewBox="0 0 24 16" width="24" height="16" aria-hidden="true" focusable="false"><rect width="24" height="16" fill="#fff"/><g fill="#b22234"><rect width="24" height="1.23"/><rect y="2.46" width="24" height="1.23"/><rect y="4.92" width="24" height="1.23"/><rect y="7.38" width="24" height="1.23"/><rect y="9.84" width="24" height="1.23"/><rect y="12.3" width="24" height="1.23"/><rect y="14.77" width="24" height="1.23"/></g><rect width="10" height="8.6" fill="#3c3b6e"/></svg></span><select id="amEmpLookupCountry"><option value="Canada">Canada</option><option value="United States">United States</option></select></span></div>
    <div class="am-al-f am-al-postal"><label for="<%= LookupPostal.ClientID %>">Postal / ZIP Code <b class="am-al-req">*</b></label><span class="am-al-clearwrap"><asp:TextBox ID="LookupPostal" runat="server" MaxLength="10" autocomplete="postal-code" placeholder="e.g. M1B 2W1" data-addr-field="LookupPostal" /><button type="button" class="am-al-clear" data-al-clear="1" aria-label="Clear postal code">&times;</button></span></div>
    <asp:LinkButton ID="SearchPostal" runat="server" OnClick="SearchPostal_Click" CausesValidation="false" CssClass="am-al-btn am-al-primary"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg> Search Address</asp:LinkButton>
    <asp:LinkButton ID="AddNewAddress" runat="server" OnClick="AddNewAddress_Click" OnClientClick="if(window.AnyminuteAddressLookup){AnyminuteAddressLookup.newAddress(this);return false;}" CausesValidation="false" CssClass="am-al-btn am-al-outline"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25zm17.71-10.21a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg> Enter Address Manually</asp:LinkButton>
   </div>
   <div id="LookupInfo" runat="server" class="am-al-info"><span class="am-al-i" aria-hidden="true">i</span><span id="amEmpLookupHint">Enter a valid Canadian postal code (e.g. M1B 2W1) or US ZIP code (e.g. 33185).</span></div>
   <asp:Literal ID="AddressNotFound" runat="server" Visible="false" />
   <asp:Panel ID="LookupResults" runat="server" CssClass="am-al-results am-al2-choice"><label for="<%= LookupChoices.ClientID %>">Select Address from Search Results</label><asp:DropDownList ID="LookupChoices" runat="server" AutoPostBack="true" OnSelectedIndexChanged="LookupChoice_Changed"><asp:ListItem Value="">Select an address from the list below</asp:ListItem></asp:DropDownList></asp:Panel>
   </section>
  </asp:Panel>

  <asp:Panel ID="AddressSection" runat="server" CssClass="am-al-details am-emp-details">
   <div class="am-al-details-head"><h3><asp:Literal ID="AddressTitle" runat="server" Text="Employee Address" /></h3><span class="am-al-pill">Address Details</span></div>
      <div class="am-al-grid">
    <div class="am-al-f"><label for="<%= StreetNo.ClientID %>">Street Number <b class="am-al-req">*</b></label><asp:TextBox ID="StreetNo" runat="server" MaxLength="20" placeholder="Enter street number" data-addr-field="StreetNo" /></div>
    <div class="am-al-f am-al-span2"><label for="<%= Line1.ClientID %>">Address Line 1 <b class="am-al-req">*</b></label><asp:TextBox ID="Line1" runat="server" MaxLength="200" autocomplete="address-line1" placeholder="Enter address line 1" data-addr-field="Line1" /></div>
    <div class="am-al-f"><label for="<%= Line2.ClientID %>">Address Line 2 <span class="am-al-opt">(Optional)</span></label><asp:TextBox ID="Line2" runat="server" MaxLength="200" autocomplete="address-line2" placeholder="Enter address line 2 (e.g. Unit, Floor, etc.)" data-addr-field="Line2" /></div>
    <div class="am-al-f"><label for="<%= SuiteType.ClientID %>">Suite Type <span class="am-al-opt">(Optional)</span></label><asp:DropDownList ID="SuiteType" runat="server" data-addr-field="SuiteType"><asp:ListItem Value="">Select</asp:ListItem><asp:ListItem>Suite</asp:ListItem><asp:ListItem>Apt</asp:ListItem><asp:ListItem>Unit</asp:ListItem></asp:DropDownList></div>
    <div class="am-al-f"><label for="<%= SuiteNumber.ClientID %>">Suite Number <span class="am-al-opt">(Optional)</span></label><asp:TextBox ID="SuiteNumber" runat="server" MaxLength="20" placeholder="Enter suite number" data-addr-field="SuiteNumber" /></div>
    <div class="am-al-subhead" role="heading" aria-level="4">City, State/Province and Country</div>
    <div class="am-al-f"><label for="<%= City.ClientID %>">City <b class="am-al-req">*</b></label><asp:TextBox ID="City" runat="server" MaxLength="100" autocomplete="address-level2" placeholder="Enter city" data-addr-field="City" /></div>
    <div class="am-al-f"><label for="<%= Province.ClientID %>">Province / State <b class="am-al-req">*</b></label><asp:DropDownList ID="Province" runat="server" data-addr-field="Province"><asp:ListItem Value="">Select</asp:ListItem><asp:ListItem>ALBERTA</asp:ListItem><asp:ListItem>BRITISH COLUMBIA</asp:ListItem><asp:ListItem>MANITOBA</asp:ListItem><asp:ListItem>NEW BRUNSWICK</asp:ListItem><asp:ListItem>NEWFOUNDLAND AND LABRADOR</asp:ListItem><asp:ListItem>NORTHWEST TERRITORIES</asp:ListItem><asp:ListItem>NOVA SCOTIA</asp:ListItem><asp:ListItem>NUNAVUT</asp:ListItem><asp:ListItem>ONTARIO</asp:ListItem><asp:ListItem>PRINCE EDWARD ISLAND</asp:ListItem><asp:ListItem>QUEBEC</asp:ListItem><asp:ListItem>SASKATCHEWAN</asp:ListItem><asp:ListItem>YUKON</asp:ListItem><asp:ListItem>ALABAMA</asp:ListItem><asp:ListItem>ALASKA</asp:ListItem><asp:ListItem>ARIZONA</asp:ListItem><asp:ListItem>ARKANSAS</asp:ListItem><asp:ListItem>CALIFORNIA</asp:ListItem><asp:ListItem>COLORADO</asp:ListItem><asp:ListItem>CONNECTICUT</asp:ListItem><asp:ListItem>DELAWARE</asp:ListItem><asp:ListItem>DISTRICT OF COLUMBIA</asp:ListItem><asp:ListItem>FLORIDA</asp:ListItem><asp:ListItem>GEORGIA</asp:ListItem><asp:ListItem>HAWAII</asp:ListItem><asp:ListItem>IDAHO</asp:ListItem><asp:ListItem>ILLINOIS</asp:ListItem><asp:ListItem>INDIANA</asp:ListItem><asp:ListItem>IOWA</asp:ListItem><asp:ListItem>KANSAS</asp:ListItem><asp:ListItem>KENTUCKY</asp:ListItem><asp:ListItem>LOUISIANA</asp:ListItem><asp:ListItem>MAINE</asp:ListItem><asp:ListItem>MARYLAND</asp:ListItem><asp:ListItem>MASSACHUSETTS</asp:ListItem><asp:ListItem>MICHIGAN</asp:ListItem><asp:ListItem>MINNESOTA</asp:ListItem><asp:ListItem>MISSISSIPPI</asp:ListItem><asp:ListItem>MISSOURI</asp:ListItem><asp:ListItem>MONTANA</asp:ListItem><asp:ListItem>NEBRASKA</asp:ListItem><asp:ListItem>NEVADA</asp:ListItem><asp:ListItem>NEW HAMPSHIRE</asp:ListItem><asp:ListItem>NEW JERSEY</asp:ListItem><asp:ListItem>NEW MEXICO</asp:ListItem><asp:ListItem>NEW YORK</asp:ListItem><asp:ListItem>NORTH CAROLINA</asp:ListItem><asp:ListItem>NORTH DAKOTA</asp:ListItem><asp:ListItem>OHIO</asp:ListItem><asp:ListItem>OKLAHOMA</asp:ListItem><asp:ListItem>OREGON</asp:ListItem><asp:ListItem>PENNSYLVANIA</asp:ListItem><asp:ListItem>RHODE ISLAND</asp:ListItem><asp:ListItem>SOUTH CAROLINA</asp:ListItem><asp:ListItem>SOUTH DAKOTA</asp:ListItem><asp:ListItem>TENNESSEE</asp:ListItem><asp:ListItem>TEXAS</asp:ListItem><asp:ListItem>UTAH</asp:ListItem><asp:ListItem>VERMONT</asp:ListItem><asp:ListItem>VIRGINIA</asp:ListItem><asp:ListItem>WASHINGTON</asp:ListItem><asp:ListItem>WEST VIRGINIA</asp:ListItem><asp:ListItem>WISCONSIN</asp:ListItem><asp:ListItem>WYOMING</asp:ListItem></asp:DropDownList></div>
    <div class="am-al-f"><label for="<%= PostalCode.ClientID %>">Postal / ZIP Code <b class="am-al-req">*</b></label><asp:TextBox ID="PostalCode" runat="server" MaxLength="20" autocomplete="postal-code" placeholder="Enter postal code" data-addr-field="PostalCode" /></div>
    <div class="am-al-f am-al-span2 am-al-countryf"><label for="<%= Country.ClientID %>">Country <b class="am-al-req">*</b></label><asp:DropDownList ID="Country" runat="server" data-addr-field="Country"><asp:ListItem>Canada</asp:ListItem><asp:ListItem>United States</asp:ListItem></asp:DropDownList></div>
   </div>
  </asp:Panel>
  </div>
  <%-- Add mode: assignments are collected here and created together with the employee. --%>
  <asp:Panel ID="NewAssignments" runat="server" CssClass="am-section am-banded"><div class="am-section-head am-band"><div><h2>Business Assignments</h2><p class="am-hint">Assign this employee to one or more businesses with roles and pay details.</p></div><asp:LinkButton ID="OpenAssignment" runat="server" OnClick="OpenAssignment_Click" CausesValidation="false" CssClass="am-button"><span class="am-plus">+</span> Add Assignment</asp:LinkButton></div>
   <div class="am-table-wrap"><table class="am-data"><thead><tr><th>Business</th><th>Roles</th><th>Employee Type</th><th>Pay Type</th><th>Pay Rate</th><th>Effective Date</th><th>End Date</th><th>Status</th><th>Action</th></tr></thead><tbody>
   <asp:Repeater ID="Pending" runat="server" OnItemCommand="Pending_ItemCommand"><ItemTemplate><tr><td><strong><%#: Eval("Business") %></strong></td><td><%#: Eval("RoleText") %></td><td><%#: Eval("EmployeeType") %></td><td><%#: Eval("PayType") %></td><td><%#: Eval("RateText") %></td><td><%#: Eval("EffectiveText") %></td><td><%#: Eval("EndText") %></td><td><span class='<%# AnyminuteEmployeeEditor.StatusPill(Eval("Status")) %>'><%#: Eval("Status") %></span></td><td><asp:LinkButton runat="server" CommandName="Remove" CommandArgument='<%# Container.ItemIndex %>' CausesValidation="false" CssClass="am-act am-act-del" ToolTip="Remove">&#128465;</asp:LinkButton></td></tr></ItemTemplate></asp:Repeater>
   <asp:PlaceHolder ID="NoPending" runat="server"><tr><td colspan="9" class="am-empty-v3"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2" fill="none" stroke="#123a63" stroke-width="1.8"/><path d="M9 7V5h6v2M3 12h18" fill="none" stroke="#123a63" stroke-width="1.8"/></svg><strong>No business assignments</strong><span>Click "Add Assignment" to assign this employee to a business.</span></td></tr></asp:PlaceHolder>
   </tbody></table></div></asp:Panel>

  <asp:Panel ID="NewAccess" runat="server" CssClass="am-section am-banded"><div class="am-band"><h2>Login &amp; Access</h2><p class="am-hint">Control whether this employee can sign in to AnyMinute.</p></div>
   <div class="am-login-v3">
    <div class="am-login-radios"><strong>Login Access <span class="am-help" title="Enabled employees can sign in with their email after setting a password.">?</span></strong><span class="am-radio-col"><asp:RadioButton ID="LoginOn" runat="server" GroupName="login" Checked="true" Text="Enable Login Access" CssClass="am-radio" /><asp:RadioButton ID="LoginOff" runat="server" GroupName="login" Text="Disable Login Access" CssClass="am-radio" /></span></div>
    <div class="am-invite-box"><asp:CheckBox ID="SendInvite" runat="server" Checked="true" Text="Send email invitation to activate account" /><span class="am-hint">The employee will receive a secure account setup invitation after being saved.</span></div>
    <span id="am-login-pill" class="am-login-pill"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2"/></svg><span id="am-login-pill-text">Login Access: Enabled</span></span>
   </div></asp:Panel>

  <%-- Edit mode tabs --%>
  <asp:Panel ID="AssignmentsTab" runat="server" Visible="false" CssClass="am-section am-banded am-assign-v6"><div class="am-band am-band-row"><div><h2><svg class="am-sec-icon am-sec-line" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M9 7h2M13 7h2M9 11h2M13 11h2M10 21v-4h4v4"/></svg>Business Assignments (<asp:Literal ID="AssignCount" runat="server" Text="0" />)</h2><p class="am-hint">Manage the employee's business assignments with roles and pay details.</p></div><asp:HyperLink ID="AddAssignmentLink" runat="server" CssClass="am-button am-btn-sm">+ Add Assignment</asp:HyperLink></div>
   <div class="am-table-wrap"><table class="am-data"><thead><tr><th>#</th><th>Business</th><th>Roles</th><th>Employee Type</th><th>Pay Type</th><th>Pay Rate</th><th>Effective Date</th><th>End Date</th><th>Status</th><th>Action</th></tr></thead><tbody>
   <asp:Repeater ID="Assignments" runat="server" OnItemCommand="Assignments_ItemCommand"><ItemTemplate><tr><td><%# Container.ItemIndex + 1 %></td><td><%#: Eval("Business") %></td><td><div class="am-role-chips"><asp:Repeater runat="server" DataSource='<%# Eval("Roles") %>'><ItemTemplate><span class='<%# "am-role-chip " + AnyminuteEmployeeEditor.RoleCss(Container.DataItem) %>'><%#: Container.DataItem %></span></ItemTemplate></asp:Repeater></div></td><td><%#: Eval("EmployeeType") %></td><td><%#: Eval("PayType") %></td><td><%#: Eval("PayRateText") %></td><td><%#: Eval("EffectiveIso") %></td><td><%#: Eval("EndIso") %></td><td><span class='<%# AnyminuteEmployeeEditor.StatusPill(Eval("Status")) %>'><%#: Eval("Status") %></span></td><td><a class="am-act" title="Edit assignment" href='<%# "EmployeeAssignment.aspx?EmployeeId=" + Eval("EmployeeId") + "&BusinessId=" + Eval("BusinessId") %>'><svg class="am-meta-ic am-pencil" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/></svg><span class="am-visually-hidden">Edit</span></a><asp:LinkButton runat="server" CssClass="am-act am-act-del am-act-danger" CommandName="End" CommandArgument='<%# Eval("BusinessId") %>' CausesValidation="false" Visible='<%# Convert.ToString(Eval("Status")) == "Active" %>' ToolTip="Remove assignment" OnClientClick="return confirm('Remove this business assignment? It will be set to Not Active with an end date of today. History is kept.');"><svg class="am-meta-ic am-trash-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6"/></svg><span class="am-visually-hidden">Remove</span></asp:LinkButton></td></tr></ItemTemplate></asp:Repeater>
   </tbody></table></div></asp:Panel>

  <asp:Panel ID="RateTab" runat="server" Visible="false">
   <div class="am-section am-card-v3"><h2><asp:Literal ID="RateFormTitle" runat="server" Text="Current Pay Rate" /></h2><p class="am-hint"><asp:Literal ID="RateFormHint" runat="server" /></p><div class="am-grid am-cols-4">
    <label class="am-field"><span>Rate Type <span class="am-req">(Required)</span></span><asp:DropDownList ID="RateType" runat="server" /></label>
    <label class="am-field"><span><asp:Literal ID="RateValueLabel" runat="server" Text="Current Pay Rate" /> <span class="am-req">(Required)</span></span><span class="am-money"><asp:TextBox ID="RateValue" runat="server" TextMode="Number" step="0.01" min="0" /></span></label>
    <label class="am-field"><span>Effective Date <span class="am-req">(Required)</span></span><asp:TextBox ID="RateEffective" runat="server" TextMode="Date" /></label>
    <label class="am-field"><span>Reason for Change <span class="am-req">(Required)</span></span><asp:TextBox ID="RateReason" runat="server" TextMode="MultiLine" Rows="2" MaxLength="200" ClientIDMode="Static" placeholder="e.g. Increase in hourly pay rate." /><span class="am-counter"><span id="am-reason-left">200</span></span></label>
   </div><div class="am-check-row"><asp:LinkButton ID="UpdateRate" runat="server" OnClick="UpdateRate_Click" CssClass="am-button"><asp:Literal ID="UpdateRateText" runat="server" Text="Update Current Rate" /></asp:LinkButton><asp:LinkButton ID="RateCancel" runat="server" OnClick="RateCancel_Click" CausesValidation="false" CssClass="am-button secondary">Cancel</asp:LinkButton></div></div>
   <div class="am-section am-card-v3"><div class="am-section-head"><div><h2>Rate History</h2><p class="am-hint">View the employee's pay rate history for the selected business. Historical rates are read-only.</p></div><asp:LinkButton ID="AddNewRate" runat="server" OnClick="AddNewRate_Click" CausesValidation="false" CssClass="am-button">+&nbsp; Add New Rate</asp:LinkButton></div>
    <label class="am-field am-inline-field"><span>Select Business <span class="am-req">(Required)</span></span><asp:DropDownList ID="RateBusiness" runat="server" AutoPostBack="true" OnSelectedIndexChanged="RateBusinessChanged" /></label>
    <div class="am-table-wrap"><table class="am-data"><thead><tr><th>#</th><th>Rate Type</th><th>Start Date</th><th>End Date</th><th>Pay Rate</th><th>Status</th><th>Action</th></tr></thead><tbody>
    <asp:Repeater ID="RateRows" runat="server" OnItemCommand="RateRows_ItemCommand"><ItemTemplate><tr><td><%# Eval("No") %></td><td><%#: Eval("RateType") %></td><td><%#: Eval("StartText") %></td><td><%#: Eval("EndText") %></td><td><%#: Eval("RateText") %></td><td><span class='<%# (bool)Eval("Current") ? "am-pill-green" : "am-pill-blue" %>'><%# (bool)Eval("Current") ? "Current" : "Historical" %></span></td><td><asp:LinkButton runat="server" Visible='<%# (bool)Eval("Current") %>' CommandName="EditCurrent" CausesValidation="false" CssClass="am-link-act">&#9998; Edit</asp:LinkButton><asp:Label runat="server" Visible='<%# !(bool)Eval("Current") %>' CssClass="am-hint" ToolTip="Historical rates are locked">&#128274; Locked</asp:Label></td></tr></ItemTemplate></asp:Repeater>
    </tbody></table></div></div>
   <div class="am-rate-info"><span class="am-rate-info-icon" aria-hidden="true">&#128274;</span><div><strong>Important Information About Pay Rates</strong><p>Current pay rate can be edited to update the employee's rate. Historical rates are locked and read-only. Use "Add New Rate" for future changes. Any corrections to historical data require a controlled, audited process.</p>
    <ul><li>The current rate is editable and will take effect from the selected effective date.</li><li>Use Add New Rate to create a new rate for future changes.</li><li>Historical rates are locked and read-only (no edit or delete).</li><li>Corrections to historical data require a controlled, audited process.</li></ul></div></div>
  </asp:Panel>

  <asp:Panel ID="AccessTab" runat="server" Visible="false">
   <div class="am-cards-3">
    <div class="am-card-v3"><h3>&#128274; Current Access Status</h3><asp:Panel ID="AccessStatusBox" runat="server" CssClass="am-status-box"><strong><asp:Literal ID="AccessState" runat="server" /></strong><p><asp:Literal ID="AccessStateText" runat="server" /></p></asp:Panel></div>
    <div class="am-card-v3"><h3>&#128100; Account Information</h3>
     <label class="am-field"><span>Username</span><span class="am-tagged"><asp:TextBox ID="AccessUser" runat="server" ReadOnly="true" /><em>Generated</em></span></label>
     <label class="am-field"><span>Login Email</span><span class="am-tagged"><asp:TextBox ID="AccessEmail" runat="server" ReadOnly="true" /><em>&#9993;</em></span></label>
     <label class="am-field"><span>Role for Portal Access</span><asp:DropDownList ID="AccessRole" runat="server" /></label></div>
    <div class="am-card-v3 am-actions-v3"><h3>&#9881; Actions</h3>
     <asp:LinkButton ID="ResendInvite" runat="server" OnClick="Resend_Click" CausesValidation="false" CssClass="am-button am-block">&#10148; Resend Invitation Email</asp:LinkButton><span class="am-hint">Send a new invitation email to the employee.</span>
     <asp:LinkButton ID="CopyLink" runat="server" OnClick="CopyLink_Click" CausesValidation="false" CssClass="am-button secondary am-block">&#128279; Copy Invitation Link</asp:LinkButton><span class="am-hint">Copy a secure activation link to share with the employee.</span>
     <asp:LinkButton ID="CancelInvite" runat="server" OnClick="CancelInvite_Click" CausesValidation="false" CssClass="am-button am-outline-danger am-block" OnClientClick="return confirm('Cancel the pending invitation? This will disable login access.');">&#8856; Cancel Invitation</asp:LinkButton><span class="am-hint">Cancel the pending invitation. This will disable login access.</span></div>
   </div>
   <asp:TextBox ID="InviteLink" runat="server" Visible="false" ReadOnly="true" ClientIDMode="Static" CssClass="am-invite-link" />
   <div class="am-cards-3">
    <div class="am-card-v3"><h3>&#128274; Login Access Settings</h3>
     <div class="am-radio-block"><asp:RadioButton ID="AccessOn" runat="server" GroupName="access" Text="Enable Login Access" /><span class="am-hint">Employee can sign in to AnyMinute.</span></div>
     <div class="am-radio-block"><asp:RadioButton ID="AccessOff" runat="server" GroupName="access" Text="Disable Login Access" /><span class="am-hint">Prevent the employee from signing in. (Existing invitation will be cancelled)</span></div></div>
    <div class="am-card-v3"><h3>&#128737; Security Settings</h3>
     <div class="am-radio-block"><asp:CheckBox ID="WelcomeEmail" runat="server" Checked="true" Text="Send welcome email when resending invitation" /><span class="am-hint">The employee will receive a secure email with instructions to set their password.</span></div>
     <div class="am-radio-block"><asp:CheckBox ID="RequireChange" runat="server" Text="Require password change at next login" /> <span class="am-help" title="The employee must set a new password the next time they sign in.">i</span></div>
     <div class="am-radio-block"><asp:CheckBox ID="TwoFactor" runat="server" Text="Enable two-factor authentication (2FA)" /> <span class="am-help" title="Stored as a setting. The sign-in page does not ask for a second code yet.">i</span></div></div>
    <div class="am-card-v3"><h3>&#128339; Access History</h3><div class="am-table-wrap"><table class="am-data"><thead><tr><th>Date</th><th>Action</th><th>Changed By</th><th>Notes</th></tr></thead><tbody>
     <asp:Repeater ID="AccessRows" runat="server"><ItemTemplate><tr><td><%#: Eval("WhenText") %></td><td><%#: Eval("ActionText") %></td><td><%#: Eval("ChangedBy") %></td><td><%#: Eval("AfterValue") %></td></tr></ItemTemplate></asp:Repeater>
     <asp:PlaceHolder ID="NoAccessRows" runat="server"><tr><td>&mdash;</td><td>&mdash;</td><td>&mdash;</td><td>No login yet.</td></tr></asp:PlaceHolder>
    </tbody></table></div></div>
   </div>
  </asp:Panel>
 </div>
 <footer class="am-dialog-foot" id="Footer" runat="server">
  <asp:LinkButton ID="Deactivate" runat="server" Visible="false" OnClick="Deactivate_Click" CausesValidation="false" CssClass="am-button am-outline-danger" style="margin-right:auto" OnClientClick="return confirm('Deactivate this employee in all your businesses?');"><svg class="am-meta-ic am-trash-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6"/></svg>Deactivate Employee</asp:LinkButton>
  <asp:HyperLink ID="CancelLink" runat="server" NavigateUrl="~/Users.aspx" CssClass="am-button secondary am-cancel">Cancel</asp:HyperLink>
  <asp:LinkButton ID="SaveEmployee" runat="server" OnClick="Save_Click" CssClass="am-button">Save Employee</asp:LinkButton>
  <asp:LinkButton ID="SaveAccess" runat="server" Visible="false" OnClick="SaveAccess_Click" CausesValidation="false" CssClass="am-button">Save Access Settings</asp:LinkButton>
 </footer>
</section>

<%-- Add mode: Add Business Assignment dialog (same fields as the assignment dialog, slides 5-6) --%>
<asp:Panel ID="AssignmentModal" runat="server" Visible="false" CssClass="am-modal-shade" role="dialog" aria-modal="true" aria-labelledby="am-new-assign-title" DefaultButton="AddPending">
 <div class="am-dialog-page">
  <header class="am-dialog-head"><div><h1 id="am-new-assign-title">Add Business Assignment</h1><p>Assign this employee to a business and set roles and pay.</p></div><asp:LinkButton runat="server" OnClick="CloseAssignment_Click" CausesValidation="false" CssClass="am-dialog-close" ToolTip="Close">&times;</asp:LinkButton></header>
  <div class="am-dialog-body">
   <asp:Label ID="ModalError" runat="server" Visible="false" CssClass="am-flash am-flash-error" role="alert" />
   <div class="am-section"><h2>Assignment Details</h2><div class="am-grid am-cols-2">
    <label class="am-field"><span>Business <span class="am-req">*</span></span><asp:DropDownList ID="NewBusiness" runat="server" AutoPostBack="true" OnSelectedIndexChanged="NewBusinessChanged" /></label>
    <div class="am-field"><span>Assign Roles <span class="am-req">*</span></span><asp:CheckBoxList ID="NewRoles" runat="server" RepeatLayout="Flow" RepeatDirection="Horizontal" CssClass="am-check-row" /></div>
    <label class="am-field"><span>Employee Type <span class="am-req">*</span></span><asp:DropDownList ID="NewType" runat="server"><asp:ListItem>Regular</asp:ListItem><asp:ListItem>Project</asp:ListItem></asp:DropDownList></label>
    <label class="am-field"><span>Pay Type <span class="am-req">*</span></span><asp:DropDownList ID="NewPayType" runat="server" /></label>
    <label class="am-field"><span>Pay Rate <span class="am-req">*</span></span><span class="am-money"><asp:TextBox ID="NewRate" runat="server" TextMode="Number" step="0.01" min="0" placeholder="0.00" /></span></label>
    <label class="am-field"><span>Billing Rate <span class="am-hint">(Optional)</span></span><span class="am-money"><asp:TextBox ID="NewBilling" runat="server" TextMode="Number" step="0.01" min="0" placeholder="0.00" /></span></label>
    <label class="am-field"><span>Effective Date <span class="am-req">*</span></span><asp:TextBox ID="NewEffective" runat="server" TextMode="Date" /></label>
    <label class="am-field"><span>End Date <span class="am-hint">(Optional)</span></span><asp:TextBox ID="NewEnd" runat="server" TextMode="Date" /></label>
    <label class="am-field"><span>Assignment Status <span class="am-req">*</span></span><asp:DropDownList ID="NewStatus" runat="server"><asp:ListItem>Active</asp:ListItem><asp:ListItem>Not Active</asp:ListItem><asp:ListItem>Terminated</asp:ListItem></asp:DropDownList></label>
    <label class="am-field"><span>Default Project</span><asp:DropDownList ID="NewProject" runat="server" /></label>
    <label class="am-field am-span-2"><span>Notes</span><asp:TextBox ID="NewNotes" runat="server" TextMode="MultiLine" MaxLength="500" ClientIDMode="Static" placeholder="Add any notes about this assignment..." /><span class="am-counter"><span id="am-notes-count">0</span>/500</span></label>
   </div></div>
  </div>
  <footer class="am-dialog-foot"><asp:LinkButton runat="server" OnClick="CloseAssignment_Click" CausesValidation="false" CssClass="am-button secondary">Cancel</asp:LinkButton><asp:LinkButton ID="AddPending" runat="server" OnClick="AddPending_Click" CausesValidation="false" CssClass="am-button">+ Add Assignment</asp:LinkButton></footer>
 </div>
</asp:Panel>
<script>(function(){
function c(i,o,m,left){var n=document.getElementById(i),s=document.getElementById(o);if(!n||!s)return;function u(){if(n.value.length>m)n.value=n.value.slice(0,m);s.textContent=left?(m-n.value.length):n.value.length;}n.addEventListener('input',u);u();}
c('RateReason','am-reason-left',200,true);c('NewNotes','am-notes-count',500,false);
var l=document.getElementById('InviteLink');if(l){l.select();try{if(navigator.clipboard)navigator.clipboard.writeText(l.value);}catch(e){}}
var pill=document.getElementById('am-login-pill'),on=document.querySelector('.am-login-radios input[value="LoginOn"]'),off=document.querySelector('.am-login-radios input[value="LoginOff"]'),inv=document.querySelector('.am-invite-box input[type=checkbox]');
function p(){if(!pill||!on)return;var e=on.checked;pill.className='am-login-pill'+(e?'':' am-off');var pt=document.getElementById('am-login-pill-text');if(pt)pt.textContent=e?'Login Access: Enabled':'Login Access: Disabled';if(inv){inv.disabled=!e;}}
if(on){on.addEventListener('change',p);off.addEventListener('change',p);p();}
var f=document.querySelector('.am-employees-v2 .am-flash');if(f){f.setAttribute('tabindex','-1');f.focus();}
})();</script>
</asp:Content>
