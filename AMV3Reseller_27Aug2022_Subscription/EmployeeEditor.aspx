   <asp:Panel ID="HeadAccessBox" runat="server" CssClass="am-access-box am-access-v3"><div class="am-access-line"><svg class="am-meta-ic am-lock-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span>Login Access</span><span class="am-access-colon">:</span> <asp:Label ID="HeadAccess" runat="server" /></div><span class="am-last-login">Last login: <asp:Literal ID="HeadLastLogin" runat="server" /></span><asp:HyperLink ID="HeadAccessLink" runat="server" CssClass="am-button secondary">Manage Login &amp; Access &rarr;</asp:HyperLink></asp:Panel>
