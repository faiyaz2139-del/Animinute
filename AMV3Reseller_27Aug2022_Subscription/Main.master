                    <li style=""><a href="#" id="EditProfile" runat="server">
                        <span class="sub_icon fa fa-home"></span>Edit Profile</a></li>
                    <asp:Repeater ID="rptCategories" runat="server" OnItemDataBound="rptMenu_OnItemBound"
                        Visible="false">
                        <ItemTemplate>
