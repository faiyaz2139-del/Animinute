<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Main.master.cs" Inherits="MasterPage" runat="server" %>

<%@ Register Src="~/Controls/AnyminuteUiOverview.ascx" TagPrefix="am" TagName="UiOverview" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>AnyMinute | Record From Anywhere</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
