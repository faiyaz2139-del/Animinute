<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="EmployeeDetails.aspx.cs" Inherits="AnyminuteEmployeeDetails" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link href="css/AnyminuteEmployees.css?v=20261024e1" rel="stylesheet" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<section class="am-employees"><header class="am-employee-heading"><a href="Users.aspx">Back to List</a><h1>Employee Profile</h1><asp:HyperLink ID="EditBasic" runat="server" Text="Edit Basic Info" CssClass="am-button" Visible="false" /></header>
<div class="am-card am-employee-profile-header"><span class="am-employee-initials"><asp:Literal ID="Initials" runat="server" /></span><div><h2><asp:Literal ID="EmployeeName" runat="server" /></h2><p><asp:Literal ID="Email" runat="server" /> <asp:Literal ID="Phone" runat="server" /></p><asp:Label ID="EmployeeStatus" runat="server" CssClass="am-badge" /></div></div>
<asp:Label ID="Notice" runat="server" Visible="false" CssClass="am-notice" role="alert" />
<nav class="am-employee-tabs" aria-label="Employee profile sections"><asp:HyperLink ID="ProfileTab" runat="server" Text="Profile" /><asp:HyperLink ID="AddressTab" runat="server" Text="Address" /><asp:HyperLink ID="AssignmentsTab" runat="server" Text="Business Assignments" /><asp:HyperLink ID="PayTab" runat="server" Text="Pay Rate History" /><asp:HyperLink ID="ProjectsTab" runat="server" Text="Projects" /><asp:HyperLink ID="TimeTab" runat="server" Text="Time Cards" /><asp:HyperLink ID="AccessTab" runat="server" Text="Login &amp; Access" /><asp:HyperLink ID="ActivityTab" runat="server" Text="Activity History" /></nav>
<div class="am-card"><label>Business assignment<asp:DropDownList ID="ContextAssignment" runat="server" AutoPostBack="true" OnSelectedIndexChanged="ContextChanged" /></label></div>
<asp:Panel ID="ProfilePane" runat="server" CssClass="am-card"><h2>Employee Information</h2><p>Profile information shown here is read-only. Owners can use Edit Basic Info where permitted.</p><asp:GridView ID="ProfileGrid" runat="server" CssClass="am-table" AutoGenerateColumns="true" /></asp:Panel>
<asp:Panel ID="AddressPane" runat="server" CssClass="am-card"><h2>Employee Address</h2><asp:Label ID="AddressScope" runat="server" /><asp:GridView ID="AddressGrid" runat="server" CssClass="am-table" AutoGenerateColumns="true" EmptyDataText="No address recorded." /></asp:Panel>
<asp:Panel ID="AssignmentsPane" runat="server" CssClass="am-card"><div class="am-employee-heading"><h2>Business Assignments</h2><asp:HyperLink ID="AddAssignment" runat="server" CssClass="am-button" Text="Add Business Assignment" Visible="false" /></div><p>Only assignments within your current business access are shown.</p><div class="am-table-wrap"><asp:GridView ID="Assignments" runat="server" CssClass="am-table" AutoGenerateColumns="false" OnRowCommand="AssignmentCommand"><Columns><asp:BoundField DataField="Business" HeaderText="Business" HtmlEncode="true" /><asp:BoundField DataField="Role" HeaderText="Role" HtmlEncode="true" /><asp:BoundField DataField="Type" HeaderText="Employee Type" HtmlEncode="true" /><asp:BoundField DataField="Rate" HeaderText="Pay Rate" HtmlEncode="true" /><asp:BoundField DataField="Status" HeaderText="Status" HtmlEncode="true" /><asp:TemplateField HeaderText="Action"><ItemTemplate><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "EmployeeAssignment.aspx?EmployeeId="+Eval("EmployeeId")+"&BusinessId="+Eval("BusinessId") %>' Text="Edit assignment role" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></asp:Panel>
<asp:Panel ID="PayPane" runat="server" CssClass="am-card"><div class="am-employee-heading"><h2>Pay Rate History</h2><asp:HyperLink ID="PayEditor" runat="server" Text="Open Pay Editor" CssClass="am-button" Visible="false" /></div><p>Rates belong to the selected employee record. A shared employee record may use the same rate across businesses. Historical records below are read-only.</p><asp:GridView ID="Rates" runat="server" CssClass="am-table" AutoGenerateColumns="false" EmptyDataText="No pay rates recorded."><Columns><asp:BoundField DataField="RateType" HeaderText="Rate Type" HtmlEncode="true" /><asp:BoundField DataField="Rate" HeaderText="Pay Rate" DataFormatString="{0:N2}" /><asp:BoundField DataField="StartDate" HeaderText="Start Date" DataFormatString="{0:yyyy-MM-dd}" /><asp:BoundField DataField="EndDate" HeaderText="End Date" DataFormatString="{0:yyyy-MM-dd}" /><asp:BoundField DataField="effectivedate" HeaderText="Effective Date" DataFormatString="{0:yyyy-MM-dd}" /></Columns></asp:GridView></asp:Panel>
<asp:Panel ID="ProjectsPane" runat="server" CssClass="am-card"><h2>Projects</h2><asp:HyperLink ID="ProjectEditor" runat="server" Text="Assign Projects" CssClass="am-button" Visible="false" /><asp:GridView ID="Projects" runat="server" CssClass="am-table" AutoGenerateColumns="true" EmptyDataText="No projects assigned in this business." /></asp:Panel>
<asp:Panel ID="TimePane" runat="server" CssClass="am-card"><h2>Time Cards</h2><asp:HyperLink ID="OpenTime" runat="server" Text="Open Time Card" CssClass="am-button" /></asp:Panel>
<asp:Panel ID="AccessPane" runat="server" CssClass="am-card"><h2>Login &amp; Access</h2><asp:Label ID="AccessMessage" runat="server" /><asp:GridView ID="AccessGrid" runat="server" AutoGenerateColumns="true" CssClass="am-table" /><p>For a password reset, the employee can use Forgot Password on the sign-in page.</p><a href="Login.aspx" target="_blank" rel="noopener">Open sign-in page</a></asp:Panel>
<asp:Panel ID="ActivityPane" runat="server" CssClass="am-card"><h2>Activity History</h2><p>Recorded audit events for the selected employee and business.</p><asp:GridView ID="Activity" runat="server" CssClass="am-table" AutoGenerateColumns="true" EmptyDataText="No recorded activity for this assignment." /></asp:Panel>
<div id="deactivate" class="am-employee-actions"><asp:Button ID="Deactivate" runat="server" Text="Deactivate Employee" CssClass="am-button secondary" Visible="false" OnClick="Deactivate_Click" OnClientClick="return confirm('Mark active employee records inactive? Existing timecards and pay history will be retained.');" /><span>Employee status and login access are managed separately.</span></div>
</section></asp:Content>
