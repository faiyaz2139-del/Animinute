<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="EmployeeDetails.aspx.cs" Inherits="AnyminuteEmployeeDetails" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link href="css/AnyminuteEmployees.css?v=20261025v13" rel="stylesheet" /><link href="css/AnyminuteEmployeesV2.css?v=20261116v83" rel="stylesheet" /><link href="css/AnyminuteFlash.css?v=20261024v2" rel="stylesheet" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<section class="am-employees am-employees-v2 am-profile-v2"><header class="am-employee-heading am-profile-head"><a href="Users.aspx" class="am-button secondary">&larr; Back to List</a><h1>Employee Profile</h1><asp:HyperLink ID="EditBasic" runat="server" CssClass="am-button" Visible="false">&#9998; Edit</asp:HyperLink></header>
<asp:Panel ID="Flash" runat="server" Visible="false" CssClass="am-flash" role="status"><span class="am-flash-icon" aria-hidden="true">&#10003;</span><asp:Literal ID="FlashText" runat="server" /></asp:Panel>
<div class="am-card am-employee-profile-header"><span class="am-employee-initials"><asp:Literal ID="Initials" runat="server" /></span><div><h2><asp:Literal ID="EmployeeName" runat="server" /></h2><p><asp:Literal ID="Email" runat="server" /> <asp:Literal ID="Phone" runat="server" /></p><asp:Label ID="EmployeeStatus" runat="server" CssClass="am-badge" /></div></div>
<asp:Label ID="Notice" runat="server" Visible="false" CssClass="am-notice" role="alert" />
<div class="am-side-layout"><nav class="am-side-nav" aria-label="Employee profile sections"><asp:HyperLink ID="ProfileTab" runat="server" Text="&#128100; Profile" /><asp:HyperLink ID="AssignmentsTab" runat="server" Text="&#128188; Business Assignments" /><asp:HyperLink ID="PayTab" runat="server" Text="&#128178; Pay Rate History" /><asp:HyperLink ID="TimeTab" runat="server" Text="&#128337; Time Cards" /><asp:HyperLink ID="DocumentsTab" runat="server" Text="&#128196; Documents" /><hr /><asp:HyperLink ID="AddressTab" runat="server" Text="Address" /><asp:HyperLink ID="ProjectsTab" runat="server" Text="Projects" /><asp:HyperLink ID="AccessTab" runat="server" Text="Login &amp; Access" /><asp:HyperLink ID="ActivityTab" runat="server" Text="Activity History" /></nav><div class="am-side-main">
<div class="am-card"><label class="am-context-assign">Business assignment<asp:DropDownList ID="ContextAssignment" runat="server" AutoPostBack="true" OnSelectedIndexChanged="ContextChanged" /></label></div>
<asp:Panel ID="ProfilePane" runat="server" CssClass="am-card"><h2>Employee Information</h2><p>Profile information shown here is read-only. Owners can use Edit where permitted.</p><asp:GridView ID="ProfileGrid" runat="server" CssClass="am-table" AutoGenerateColumns="true" /></asp:Panel>
<asp:Panel ID="AddressPane" runat="server" CssClass="am-card"><h2>Employee Address</h2><asp:Label ID="AddressScope" runat="server" /><asp:GridView ID="AddressGrid" runat="server" CssClass="am-table" AutoGenerateColumns="true" EmptyDataText="No address recorded." /></asp:Panel>
<asp:Panel ID="AssignmentsPane" runat="server" CssClass="am-card"><div class="am-employee-heading"><h2>Business Assignments (<asp:Literal ID="AssignmentCount" runat="server" />)</h2><asp:HyperLink ID="AddAssignment" runat="server" CssClass="am-button" Visible="false">+ Add Business Assignment</asp:HyperLink></div><div class="am-table-wrap"><table class="am-data"><thead><tr><th>Business</th><th>Roles</th><th>Employee Type</th><th>Pay Type</th><th>Pay Rate</th><th>Effective Date</th><th>Status</th><th>Action</th></tr></thead><tbody>
<asp:Repeater ID="Assignments" runat="server" OnItemCommand="AssignmentCommand"><ItemTemplate><tr><td><strong><%#: Eval("Business") %></strong></td><td><div class="am-role-chips"><asp:Repeater runat="server" DataSource='<%# Eval("Roles") %>'><ItemTemplate><span class='<%# "am-role-chip " + AnyminuteEmployeeEditor.RoleCss(Container.DataItem) %>'><%#: Container.DataItem %></span></ItemTemplate></asp:Repeater></div></td><td><%#: Eval("EmployeeType") %></td><td><%#: Eval("PayType") %></td><td><%#: Eval("PayRateText") %></td><td><%#: Eval("EffectiveText") %></td><td><span class='<%# AnyminuteEmployeeEditor.StatusPill(Eval("Status")) %>'><%#: Eval("Status") %></span></td><td style="white-space:nowrap"><asp:HyperLink runat="server" CssClass="am-act" ToolTip="Edit assignment" Visible='<%# CanManage %>' NavigateUrl='<%# "EmployeeAssignment.aspx?EmployeeId="+Eval("EmployeeId")+"&BusinessId="+Eval("BusinessId") %>' Text="&#9998;" /><asp:LinkButton runat="server" CssClass="am-act am-act-del" ToolTip="Remove assignment" Visible='<%# CanManage %>' CommandName="RemoveAssignment" CommandArgument='<%# Eval("BusinessId") %>' CausesValidation="false" OnClientClick="return confirm('Remove this business assignment? Time cards and history are kept.');">&#128465;</asp:LinkButton></td></tr></ItemTemplate></asp:Repeater>
</tbody></table></div></asp:Panel>
<asp:Panel ID="PayPane" runat="server" CssClass="am-card"><div class="am-employee-heading"><h2>Pay Rate History</h2><asp:HyperLink ID="PayEditor" runat="server" Text="Open Pay Editor" CssClass="am-button" Visible="false" /></div><p>Rates belong to the selected employee record. A shared employee record may use the same rate across businesses. Only the current rate can be changed (through Open Pay Editor); historical records below are locked.</p><asp:GridView ID="Rates" runat="server" CssClass="am-table" AutoGenerateColumns="false" EmptyDataText="No pay rates recorded."><Columns><asp:TemplateField HeaderText="Status"><ItemTemplate><span class='<%# "am-badge " + Eval("RateStatus") %>'><%#: Eval("RateStatus") %></span></ItemTemplate></asp:TemplateField><asp:BoundField DataField="RateType" HeaderText="Rate Type" HtmlEncode="true" /><asp:BoundField DataField="Rate" HeaderText="Pay Rate" DataFormatString="{0:N2}" /><asp:BoundField DataField="StartDate" HeaderText="Start Date" DataFormatString="{0:yyyy-MM-dd}" /><asp:BoundField DataField="EndDate" HeaderText="End Date" DataFormatString="{0:yyyy-MM-dd}" /><asp:BoundField DataField="effectivedate" HeaderText="Effective Date" DataFormatString="{0:yyyy-MM-dd}" /><asp:BoundField DataField="Editing" HeaderText="Edit" HtmlEncode="true" /></Columns></asp:GridView></asp:Panel>
<asp:Panel ID="ProjectsPane" runat="server" CssClass="am-card"><h2>Projects</h2><asp:HyperLink ID="ProjectEditor" runat="server" Text="Assign Projects" CssClass="am-button" Visible="false" /><asp:GridView ID="Projects" runat="server" CssClass="am-table" AutoGenerateColumns="true" EmptyDataText="No projects assigned in this business." /></asp:Panel>
<asp:Panel ID="DocumentsPane" runat="server" CssClass="am-card"><h2>Documents</h2><p class="am-hint">Employee document storage is not part of the current application, so there are no documents to show.</p></asp:Panel>
<asp:Panel ID="TimePane" runat="server" CssClass="am-card"><h2>Time Cards</h2><asp:HyperLink ID="OpenTime" runat="server" Text="Open Time Card" CssClass="am-button" /></asp:Panel>
<asp:Panel ID="AccessPane" runat="server" CssClass="am-card"><h2>Login &amp; Access</h2><asp:Label ID="AccessMessage" runat="server" /><asp:GridView ID="AccessGrid" runat="server" AutoGenerateColumns="true" CssClass="am-table" /><asp:Panel ID="AccessHistoryPanel" runat="server" Visible="false"><h3>Recent Access Activity</h3><p>Last recorded clock activity for this assignment. Sign-in history is not recorded by the current application.</p><asp:GridView ID="AccessHistory" runat="server" AutoGenerateColumns="true" CssClass="am-table" EmptyDataText="No recorded activity." /></asp:Panel><p>For a password reset, the employee can use Forgot Password on the sign-in page.</p><a href="Login.aspx" target="_blank" rel="noopener">Open sign-in page</a></asp:Panel>
<asp:Panel ID="ActivityPane" runat="server" CssClass="am-card"><h2>Activity History</h2><p>Recorded audit events for the selected employee and business.</p><asp:GridView ID="Activity" runat="server" CssClass="am-table" AutoGenerateColumns="true" EmptyDataText="No recorded activity for this assignment." /></asp:Panel>
</div></div>
<div id="deactivate" class="am-employee-actions"><asp:Button ID="Deactivate" runat="server" Text="Deactivate Employee" CssClass="am-button secondary" Visible="false" OnClick="Deactivate_Click" OnClientClick="return confirm('Mark active employee records inactive? Existing timecards and pay history will be retained.');" /><span>Employee status and login access are managed separately.</span></div>
</section></asp:Content>
