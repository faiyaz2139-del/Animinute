<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="BusinessSettings.aspx.cs" Inherits="AnyminuteBusinessSettings" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server" /><asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><section class="am-card"><div class="am-title"><div><h1>Business Settings</h1><p>Configure attendance time and clock-out estimates.</p></div></div><div class="am-fields"><label>Business<asp:DropDownList ID="Business" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Changed" /></label><label>Time zone<asp:DropDownList ID="Zone" runat="server" /></label><div class="am-settings-check"><asp:CheckBox ID="Estimates" runat="server" Text="Suggest last same-day activity when clock-out is missing" /></div></div><div class="am-notice">The last recorded activity is evidence for an estimate, not proof of when work ended. Employees or authorized reviewers must confirm it. The initial default is Toronto / Eastern time; select the actual business time zone.</div><asp:Button ID="Save" runat="server" Text="Save Settings" OnClick="Save_Click" /><asp:Label ID="Message" runat="server" /></section></asp:Content>
