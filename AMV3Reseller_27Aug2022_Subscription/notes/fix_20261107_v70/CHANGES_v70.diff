+<style>
+.am-empsel{max-width:760px}
+.am-empsel .am-empsel-f{display:flex;flex-direction:column;gap:6px;margin:0 0 16px}
+.am-empsel .am-empsel-f>label{font-weight:700;font-size:14px;color:#0f172a}
