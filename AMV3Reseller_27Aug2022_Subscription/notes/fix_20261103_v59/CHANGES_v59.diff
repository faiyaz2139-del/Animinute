diff --git a/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteSubscriberErase.cs b/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteSubscriberErase.cs
new file mode 100644
index 0000000..54957ba
--- /dev/null
+++ b/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteSubscriberErase.cs
