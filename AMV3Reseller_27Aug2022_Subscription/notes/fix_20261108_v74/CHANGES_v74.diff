+html body.am-reference.am-typography.am-drawer-nav.am-sa-pinned.am-drawer-open .am-sidebar{box-shadow:none!important}
+}
+/* Editorial title and section hierarchy. Cards/forms remain compact sans. */
+html body.am-reference.am-typography h1{font-size:42px!important;line-height:1.16!important;font-weight:400!important;color:#182b33!important;letter-spacing:normal!important}
+html body.am-reference.am-typography .am-heading,
+html body.am-reference.am-typography .am-title,
