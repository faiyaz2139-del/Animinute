+html body.am-reference.am-typography .am-quick-grid>a:nth-child(4n+3){background:#f1e8fb!important}
+html body.am-reference.am-typography .am-quick-grid>a:nth-child(4n){background:#fdf0e7!important}
+html body.am-reference.am-typography .sa-rsl-grid{gap:32px!important}
+html body.am-reference.am-typography input[aria-invalid=true],
+html body.am-reference.am-typography .input-validation-error{border-color:#b42318!important}
+/* Preserve print behavior after dashboard-specific rules. */
+@media print{html body.am-reference.am-typography .am-quick-actions{display:none!important}}
+/* Remove the old console's extra 4/8px inset so every role shares the measured content edge. */
+html body.am-reference.am-typography .sa-page{--sa-ink:#172c3b;--sa-line:#dce4e8;--sa-bg:#fff;font-size:14px;padding:0 0 32px}
