+html body.am-reference.am-typography .am-card,
+html body.am-reference.am-typography .sa-card{padding:16px!important;margin-bottom:20px!important}
+html body.am-reference.am-typography .am-card h2,
+html body.am-reference.am-typography .sa-card h2{font-size:18px;line-height:1.3;font-weight:600}
+html body.am-reference.am-typography .am-ap-sechead{margin-bottom:20px!important}
+html body.am-reference.am-typography .am-notice,
+html body.am-reference.am-typography .sa-flash:not(.sa-warn){background:#f6fbff!important;border:1px solid #d4e9f5!important;border-left:4px solid #1261a0!important;border-radius:5px!important;color:#173e57!important;padding:16px 20px!important;box-shadow:none!important}
