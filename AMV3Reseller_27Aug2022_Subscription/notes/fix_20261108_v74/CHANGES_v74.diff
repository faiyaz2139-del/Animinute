+html body.am-reference.am-typography .am-businesses-header{flex-wrap:wrap!important;gap:20px!important}
+html body.am-reference.am-typography .am-businesses-header>div{flex:1 1 100%}
+html body.am-reference.am-typography .am-quick-actions.am-card{width:100%;border:0!important;padding:0!important;margin:0!important;background:transparent!important}
+html body.am-reference.am-typography .am-quick-grid{display:grid!important;grid-template-columns:repeat(auto-fit,minmax(160px,1fr))!important;gap:20px!important}
+html body.am-reference.am-typography .am-quick-grid>a{border:0!important;border-radius:8px!important;min-height:38px!important;padding:10px 16px!important;color:#172c3b!important;font-size:13px!important;font-weight:600!important;background:#eafef3!important}
