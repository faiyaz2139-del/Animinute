<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="TimeCards.aspx.cs" Inherits="AnyminuteTimeCards" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server" />
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><section class="am-card"><div class="am-title"><div><h1><asp:Literal ID="Heading" runat="server" Text="Team Timesheets" /></h1><p><asp:Literal ID="Intro" runat="server" Text="Weekly overview with daily details and approval status." /></p></div></div><asp:Label ID="Notice" runat="server" Visible="false" CssClass="am-notice" role="status" />
<p class="am-muted">Approvals shows submitted weeks you are authorized to review. Your own submissions remain under Time Cards and require another reviewer. Select the same week as the submitted timecard.</p>
<div class="am-toolbar"><label><span>Week starting</span><asp:TextBox ID="Week" runat="server" TextMode="Date" AutoPostBack="true" OnTextChanged="FilterChanged" /></label><label><span>Search employees</span><input type="search" data-search="#cards-grid" placeholder="Employee or business..." /></label><label><span>Status</span><asp:DropDownList ID="State" runat="server" AutoPostBack="true" OnSelectedIndexChanged="FilterChanged"><asp:ListItem Value="All">All statuses</asp:ListItem><asp:ListItem>Draft</asp:ListItem><asp:ListItem>Submitted</asp:ListItem><asp:ListItem>Approved</asp:ListItem><asp:ListItem>Rejected</asp:ListItem></asp:DropDownList></label></div><div class="am-table-wrap"><table id="cards-grid" class="am-table"><thead><tr><th>Employee</th><th>Business</th><th>Net Hours</th><th>Status</th><th>Action</th></tr></thead><tbody><asp:Repeater ID="Rows" runat="server"><ItemTemplate><tr><td><strong><%#: Eval("EmpName") %></strong><small>ID <%#: Eval("EmployeeID") %></small></td><td><%#: Eval("BusinessName") %></td><td><%#: Eval("NetDisplay") %></td><td><span class='<%# "am-badge "+Eval("State") %>'><%#: Eval("State") %></span></td><td><a class="am-button secondary" href='<%# AnyminuteModernScope.Url("WeekTimeCard.aspx",Convert.ToInt32(Eval("BusinessID")),Convert.ToInt32(Eval("EmployeeID")))+"&Week="+Eval("WeekStart","{0:yyyy-MM-dd}") %>'>Open Time Card</a></td></tr></ItemTemplate></asp:Repeater></tbody></table></div><asp:Label ID="Empty" runat="server" CssClass="am-empty" Text="No timecards match the selected week and status." /></section></asp:Content>
