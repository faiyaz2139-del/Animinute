<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="Users.aspx.cs" Inherits="AnyminuteEmployeesDirectory" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link href="css/AnyminuteEmployees.css?v=20261119v91" rel="stylesheet" /><link href="css/AnyminuteEmployeesV2.css?v=20261119v91" rel="stylesheet" /><link href="css/AnyminuteFlash.css?v=20261119v91" rel="stylesheet" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<section class="am-card am-employees am-employees-v2">
<asp:Panel ID="Flash" runat="server" Visible="false" CssClass="am-flash" role="status"><span class="am-flash-icon" aria-hidden="true">&#10003;</span><asp:Literal ID="FlashText" runat="server" /></asp:Panel>
<div class="am-title"><div><h1>Employees</h1><p>Manage employees and their business assignments.</p></div><asp:HyperLink ID="AddEmployee" runat="server" NavigateUrl="~/EmployeeEditor.aspx" CssClass="am-button"><span aria-hidden="true">+</span> Add Employee</asp:HyperLink></div>
<div class="am-stats am-employee-metrics am-metrics-v2">
 <div class="am-stat"><span class="am-metric-icon am-metric-blue" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M16 11a4 4 0 1 0-3.9-5A4 4 0 0 1 16 11zM8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-3 0-7 1.5-7 4.5V20h14v-2.5C15 14.5 11 13 8 13zm8 0c-.3 0-.7 0-1.1.1A5 5 0 0 1 17 17.5V20h6v-2.5c0-3-4-4.5-7-4.5z"/></svg></span><div><small>Total Employees</small><strong><asp:Literal ID="TotalEmployees" runat="server" /></strong></div></div>
 <div class="am-stat"><span class="am-metric-icon am-metric-purple" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M10 3h4a2 2 0 0 1 2 2v2h4a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h4V5a2 2 0 0 1 2-2zm0 4h4V5h-4v2z"/></svg></span><div><small>Total Assignments</small><strong><asp:Literal ID="TotalAssignments" runat="server" /></strong></div></div>
 <div class="am-stat"><span class="am-metric-icon am-metric-green" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.5 14.5-4-4 1.4-1.4 2.6 2.6 5.6-5.6 1.4 1.4-7 7z"/></svg></span><div>Active Employees<strong class="am-metric-good"><asp:Literal ID="ActiveEmployees" runat="server" /></strong></div></div>
 <div class="am-stat"><span class="am-metric-icon am-metric-red" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 12.8-1.4 1.4L12 13.4l-2.8 2.8-1.4-1.4 2.8-2.8-2.8-2.8 1.4-1.4 2.8 2.8 2.8-2.8 1.4 1.4-2.8 2.8 2.8 2.8z"/></svg></span><div>Inactive Employees<strong class="am-metric-bad"><asp:Literal ID="InactiveEmployees" runat="server" /></strong></div></div>
</div>
<asp:Panel runat="server" DefaultButton="SearchButton" CssClass="am-toolbar am-employee-filters am-filters-v2">
<label class="am-filter-search"><span>Search employees</span><asp:TextBox ID="Search" runat="server" TextMode="Search" MaxLength="150" placeholder="Search by name, email or phone..." /></label>
<label><span>Business</span><asp:DropDownList ID="Business" runat="server" /></label><label><span>Role</span><asp:DropDownList ID="Role" runat="server" /></label>
<label><span>Status</span><asp:DropDownList ID="Status" runat="server"><asp:ListItem Value="All">All statuses</asp:ListItem><asp:ListItem>Active</asp:ListItem><asp:ListItem>Inactive</asp:ListItem><asp:ListItem>On Leave</asp:ListItem><asp:ListItem>Terminated</asp:ListItem></asp:DropDownList></label>
<div class="am-actions"><asp:Button runat="server" Text="Clear" OnClick="Clear_Click" CausesValidation="false" CssClass="am-button secondary" /><asp:Button ID="SearchButton" runat="server" Text="Search" OnClick="Filter_Click" CausesValidation="false" CssClass="am-button" /></div></asp:Panel>
<div class="am-table-wrap"><table class="am-table am-employee-table am-employee-table-v2"><thead><tr><th class="am-col-check"><input type="checkbox" id="am-select-all" aria-label="Select all employees on this page" /></th>
<th><asp:LinkButton runat="server" CommandArgument="Name" OnCommand="Sort_Command" CausesValidation="false" CssClass="am-sort">Employee <span class="am-sort-icon" aria-hidden="true"><svg viewBox="0 0 12 16" width="10" height="13" focusable="false"><path fill="currentColor" d="M6 1.2l4 5.2H2L6 1.2zm0 13.6l-4-5.2h8L6 14.8z"/></svg></span></asp:LinkButton></th>
<th><asp:LinkButton runat="server" CommandArgument="Businesses" OnCommand="Sort_Command" CausesValidation="false" CssClass="am-sort">Businesses <span class="am-sort-icon" aria-hidden="true"><svg viewBox="0 0 12 16" width="10" height="13" focusable="false"><path fill="currentColor" d="M6 1.2l4 5.2H2L6 1.2zm0 13.6l-4-5.2h8L6 14.8z"/></svg></span></asp:LinkButton></th>
<th><asp:LinkButton runat="server" CommandArgument="Roles" OnCommand="Sort_Command" CausesValidation="false" CssClass="am-sort">Roles <span class="am-sort-icon" aria-hidden="true"><svg viewBox="0 0 12 16" width="10" height="13" focusable="false"><path fill="currentColor" d="M6 1.2l4 5.2H2L6 1.2zm0 13.6l-4-5.2h8L6 14.8z"/></svg></span></asp:LinkButton></th>
<th><asp:LinkButton runat="server" CommandArgument="Rate" OnCommand="Sort_Command" CausesValidation="false" CssClass="am-sort">Rate <span class="am-sort-icon" aria-hidden="true"><svg viewBox="0 0 12 16" width="10" height="13" focusable="false"><path fill="currentColor" d="M6 1.2l4 5.2H2L6 1.2zm0 13.6l-4-5.2h8L6 14.8z"/></svg></span></asp:LinkButton></th>
<th><asp:LinkButton runat="server" CommandArgument="Status" OnCommand="Sort_Command" CausesValidation="false" CssClass="am-sort">Status <span class="am-sort-icon" aria-hidden="true"><svg viewBox="0 0 12 16" width="10" height="13" focusable="false"><path fill="currentColor" d="M6 1.2l4 5.2H2L6 1.2zm0 13.6l-4-5.2h8L6 14.8z"/></svg></span></asp:LinkButton></th><th>Action</th></tr></thead><tbody>
<asp:Repeater ID="Rows" runat="server"><ItemTemplate><tr><td class="am-col-check"><input type="checkbox" class="am-row-check" value='<%# Eval("EmployeeId") %>' aria-label='<%#: "Select " + Eval("Name") %>' /></td>
<td><div class="am-employee-identity"><span class='<%# "am-employee-initials " + AvatarCss(Eval("Name")) %>'><%#: Eval("Initials") %></span><div><strong><%#: Eval("Name") %></strong><span><%#: Eval("Email") %></span><span><%#: Eval("Phone") %></span></div></div></td>
<td><a class="am-business-pill" href='<%# Eval("AssignmentUrl") %>' title="Open employee profile and business assignments"><%#: Eval("BusinessLabel") %> <span aria-hidden="true">&#709;</span></a></td>
<td><div class="am-role-chips"><asp:Repeater runat="server" DataSource='<%# Eval("RoleNames") %>'><ItemTemplate><span class='<%# "am-role-chip " + AnyminuteEmployeesDirectory.RoleCss(Container.DataItem) %>'><%#: Container.DataItem %></span></ItemTemplate></asp:Repeater></div></td>
<td class="am-rate-cell"><%#: RateText(Eval("Rate")) %></td><td><span class='<%# "am-badge " + Eval("StatusCss") %>'><%#: Eval("Status") %></span></td>
<td><div class="am-employee-actions"><a class="am-icon-action am-icon-square" href='<%# Eval("ProfileUrl") %>' aria-label='<%#: "View " + Eval("Name") %>' title="View profile"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 5c5 0 9 4.5 10 7-1 2.5-5 7-10 7S3 14.5 2 12c1-2.5 5-7 10-7zm0 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm0 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/></svg></a><asp:HyperLink runat="server" CssClass="am-icon-action am-icon-square" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "~/EmployeeEditor.aspx?EmployeeId=" + Eval("EmployeeId") %>' ToolTip="Edit employee"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11zM20.7 7a1 1 0 0 0 0-1.4l-2.3-2.3a1 1 0 0 0-1.4 0l-1.8 1.8 3.8 3.8L20.7 7z"/></svg></asp:HyperLink>
<details class="am-employee-menu am-business-status-menu"><summary aria-label="More employee actions">&#8942;</summary><div><strong class="am-employee-menu-title">More Actions &#8212; <%#: Eval("Name") %></strong><a href='<%# "EmployeeAssignment.aspx?EmployeeId=" + Eval("EmployeeId") %>'>Manage Business Assignments</a><a href='<%# Eval("AssignmentUrl") %>'>Manage Roles &amp; Permissions</a><a href='<%# "EmployeeEditor.aspx?EmployeeId=" + Eval("EmployeeId") + "&tab=rate" %>'>Pay Rate History</a><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# Eval("ProfileUrl")+"&tab=projects" %>' Text="Assign Projects" /><a href='<%# Eval("ProfileUrl")+"&tab=time" %>'>View Time Cards</a><a href='<%# "EmployeeEditor.aspx?EmployeeId=" + Eval("EmployeeId") + "&tab=access" %>'>Reset Password / Login &amp; Access</a><a href='<%# Eval("ProfileUrl")+"&tab=activity" %>'>Activity History</a><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# Eval("ProfileUrl")+"&action=deactivate#deactivate" %>' CssClass="am-danger-link" Text="Deactivate Employee" /></div></details></div></td></tr></ItemTemplate></asp:Repeater>
</tbody></table></div><asp:Label ID="Empty" runat="server" Visible="false" CssClass="am-empty" Text="No matching employees." />
<footer class="am-employee-pager am-pager-v2"><asp:Label ID="Count" runat="server" /><nav aria-label="Pages" class="am-page-numbers"><asp:LinkButton ID="Previous" runat="server" OnClick="Previous_Click" CausesValidation="false" CssClass="am-page" aria-label="Previous page">&#8249;</asp:LinkButton><asp:Repeater ID="Pages" runat="server"><ItemTemplate><asp:LinkButton runat="server" CommandArgument='<%# Container.DataItem %>' OnCommand="Page_Command" CausesValidation="false" CssClass='<%# "am-page" + ((int)Container.DataItem == CurrentPage ? " is-current" : "") %>'><%# Container.DataItem %></asp:LinkButton></ItemTemplate></asp:Repeater><asp:LinkButton ID="Next" runat="server" OnClick="Next_Click" CausesValidation="false" CssClass="am-page" aria-label="Next page">&#8250;</asp:LinkButton></nav><asp:Label ID="PageNumber" runat="server" CssClass="am-visually-hidden" /><label class="am-per-page"><span class="am-visually-hidden">Rows per page</span><asp:DropDownList ID="PageSize" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Filter_Click"><asp:ListItem Value="10">10 per page</asp:ListItem><asp:ListItem Value="25">25 per page</asp:ListItem><asp:ListItem Value="50">50 per page</asp:ListItem></asp:DropDownList></label></footer>
</section>
<script>(function(){var all=document.getElementById('am-select-all');if(!all)return;all.addEventListener('change',function(){document.querySelectorAll('.am-row-check').forEach(function(c){c.checked=all.checked;});});})();</script>
</asp:Content>
