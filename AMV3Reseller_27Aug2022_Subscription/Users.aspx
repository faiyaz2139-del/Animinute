<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="Users.aspx.cs" Inherits="AnyminuteEmployeesDirectory" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link href="css/AnyminuteEmployees.css?v=20261024f1" rel="stylesheet" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<section class="am-employees"><header class="am-employee-heading"><div><h1>Employees</h1><p>Manage employees and their business assignments.</p></div><asp:HyperLink ID="AddEmployee" runat="server" Text="Add Employee" NavigateUrl="~/Add_EmployeeV2.aspx" CssClass="am-button" /></header>
<div class="am-employee-metrics"><div>Total Employees<strong><asp:Literal ID="TotalEmployees" runat="server" /></strong></div><div>Total Assignments<strong><asp:Literal ID="TotalAssignments" runat="server" /></strong></div><div>Active Employees<strong><asp:Literal ID="ActiveEmployees" runat="server" /></strong><small>At least one active assignment</small></div><div>Inactive Employees<strong><asp:Literal ID="InactiveEmployees" runat="server" /></strong><small>No active assignments</small></div></div>
<p>Counts and lists include only business assignments you can currently access.</p>
<div class="am-card"><div class="am-employee-filters">
<label>Search by name, email or phone<asp:TextBox ID="Search" runat="server" TextMode="Search" MaxLength="150" /></label>
<label>Business<asp:DropDownList ID="Business" runat="server" /></label><label>Role<asp:DropDownList ID="Role" runat="server" /></label>
<label>Status<asp:DropDownList ID="Status" runat="server"><asp:ListItem Value="All">All statuses</asp:ListItem><asp:ListItem>Active</asp:ListItem><asp:ListItem>Inactive</asp:ListItem><asp:ListItem>On Leave</asp:ListItem><asp:ListItem>Terminated</asp:ListItem></asp:DropDownList></label>
<label>Sort<asp:DropDownList ID="Sort" runat="server"><asp:ListItem Value="Name">Employee name</asp:ListItem><asp:ListItem Value="Businesses">Business count</asp:ListItem><asp:ListItem Value="Status">Status</asp:ListItem></asp:DropDownList></label>
<asp:Button runat="server" Text="Clear" OnClick="Clear_Click" CausesValidation="false" CssClass="am-button secondary" /><asp:Button runat="server" Text="Search" OnClick="Filter_Click" CausesValidation="false" CssClass="am-button" /></div>
<div class="am-table-wrap"><table class="am-table am-employee-table"><thead><tr><th>Employee</th><th>Businesses</th><th>Roles</th><th>Employee Type</th><th>Rate</th><th>Status</th><th>Action</th></tr></thead><tbody>
<asp:Repeater ID="Rows" runat="server"><ItemTemplate><tr><td><div class="am-employee-identity"><span class="am-employee-initials"><%#: Eval("Initials") %></span><div><strong><%#: Eval("Name") %></strong><span><%#: Eval("Email") %></span><span><%#: Eval("Phone") %></span></div></div></td>
<td><a class="am-employee-business-count" href='<%# Eval("AssignmentUrl") %>' title="Open business assignments"><%#: Eval("BusinessLabel") %> <span aria-hidden="true">&#8250;</span></a></td><td><div class="am-role-chips"><asp:Repeater runat="server" DataSource='<%# Eval("RoleNames") %>'><ItemTemplate><span class="am-role-chip"><%#: Container.DataItem %></span></ItemTemplate></asp:Repeater></div></td><td><%#: Eval("Type") %></td><td><%#: Eval("Rate") %></td><td><span class='<%# "am-badge " + Eval("StatusCss") %>'><%#: Eval("Status") %></span></td>
<td><div class="am-employee-actions"><a class="am-icon-action" href='<%# Eval("ProfileUrl") %>' aria-label="View employee profile (read-only)" title="View profile">&#128065;</a><asp:HyperLink runat="server" CssClass="am-icon-action" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# Eval("ProfileUrl")+"&edit=1" %>' ToolTip="Edit personal information" Text="&#9998;" />
<details class="am-employee-menu am-business-status-menu"><summary aria-label="More employee actions">&#8942;</summary><div><strong class="am-employee-menu-title">More Actions &#8212; <%#: Eval("Name") %></strong><a href='<%# Eval("AssignmentUrl") %>'>Manage Business Assignments</a><a href='<%# Eval("AssignmentUrl") %>'>Manage Roles &amp; Permissions</a><a href='<%# Eval("ProfileUrl")+"&tab=pay" %>'>Pay Rate History</a><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# Eval("ProfileUrl")+"&tab=projects" %>' Text="Assign Projects" /><a href='<%# Eval("ProfileUrl")+"&tab=time" %>'>View Time Cards</a><a href='<%# Eval("ProfileUrl")+"&tab=access" %>'>Reset Password / Login &amp; Access</a><a href='<%# Eval("ProfileUrl")+"&tab=activity" %>'>Activity History</a><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# Eval("ProfileUrl")+"&action=deactivate#deactivate" %>' CssClass="am-danger-link" Text="Deactivate Employee" /></div></details></div></td></tr></ItemTemplate></asp:Repeater>
</tbody></table></div><asp:Label ID="Empty" runat="server" Visible="false" Text="No matching employees." />
<footer class="am-employee-pager"><asp:Label ID="Count" runat="server" /><div><asp:Button ID="Previous" runat="server" Text="Previous" OnClick="Previous_Click" CausesValidation="false" /><asp:Label ID="PageNumber" runat="server" /><asp:Button ID="Next" runat="server" Text="Next" OnClick="Next_Click" CausesValidation="false" /></div><label>Rows per page<asp:DropDownList ID="PageSize" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Filter_Click"><asp:ListItem>10</asp:ListItem><asp:ListItem>25</asp:ListItem><asp:ListItem>50</asp:ListItem></asp:DropDownList></label></footer>
</div></section></asp:Content>
