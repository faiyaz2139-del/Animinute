<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="Notifications.aspx.cs" Inherits="AnyminuteNotifications" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server" /><asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><section class="am-card"><div class="am-title"><div><h1>Notifications</h1><p>Submission and approval updates for your account.</p></div></div><asp:Repeater ID="Rows" runat="server" OnItemCommand="Command"><ItemTemplate><div class="am-card"><strong><%#: Eval("Message") %></strong><p class="am-muted"><%#: Eval("CreatedAtUTC","{0:yyyy-MM-dd HH:mm}") %> UTC</p><div class="am-actions"><a class="am-button secondary" href='<%# AnyminuteModernScope.Url("WeekTimeCard.aspx",Convert.ToInt32(Eval("BusinessID")),Convert.ToInt32(Eval("EmployeeID")))+"&Week="+Eval("WeekStart","{0:yyyy-MM-dd}") %>'>Open Time Card</a><asp:LinkButton runat="server" Text="Mark read" CommandArgument='<%# Eval("NotificationID") %>' Visible='<%# Eval("ReadAtUTC")==DBNull.Value %>' /></div></div></ItemTemplate></asp:Repeater><asp:Label ID="Empty" runat="server" Text="No notifications yet." /></section></asp:Content>
