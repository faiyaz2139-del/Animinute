    <style>
        .GridPager a, .GridPager span {
            display: block;
            height: 35px;
            width: 35px;
            font-weight: bold;
            text-align: center;
            text-decoration: none;
            padding: 10px;
        }

        .GridPager a {
            background-color: #fff;
            color: #969696;
            border: 1px solid #dedede;
        }

            .GridPager a:hover {
                color: #337ab7;
            }

        .GridPager span {
            background-color: #337ab7;
            color: #fff;
            border: 1px solid #dedede;
        }

        .buttonhyperlink {
           
            border: 1px solid #607DF2;
            display: block;
            background-color: #607DF2;
            border-radius: 0px;
            color: white;
            padding: 5px 25px;
            text-align: center;
            text-decoration: none;
            display: block;
            margin-top: -1px;
            font-family: sans-serif;
            font-size: medium;
        }

        .dropdownlist {
           
            border: 1px solid #607DF2;
            display: block;
            background-color: #ECF0F3;
            border-radius: 30px;
            color: black;
            padding: 10px 25px;
            text-align: center;
            text-decoration: none;
            display: block;
            margin-top: -1px;
            font-family: sans-serif;
            font-size: medium;
        }

        .text {
            background: url(/images/calendar.png) no-repeat right;
            border: 1px solid #808080;
            height: 40px;
            background-color: white;
            display: block;
            width: 120%;
            padding: 6px 12px;
            font-size: 14px;
            line-height: 1.42857143;
            color: #555;
            background-color: #fff;
            border-radius: 4px;
        }
    </style>
    <link href="http://cdn.rawgit.com/davidstutz/bootstrap-multiselect/master/dist/css/bootstrap-multiselect.css" rel="stylesheet" type="text/css" />
    <script src="http://cdn.rawgit.com/davidstutz/bootstrap-multiselect/master/dist/js/bootstrap-multiselect.js" type="text/javascript"></script>
    <script>
        function ShowDocument(hdfselected, dtfrom, dtto, businessname, counter, empid, empname, type) {
            var url = "document.aspx?hfSelected=" + hdfselected + "&dtfrom=  " + dtfrom + "&dtto=  " + dtto + "&businessname=  " + businessname + "&counter=  " + counter + "&empid=  " + empid + " &empname=  " + empname + "&type=  " + type;
            document.location.href = url;
            return false;

        }
    </script>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">
    <div class="panel panel-default" id="cardbus" runat="server" style="display:none;">
        <div class="panel-body" style="margin-top: 0px;">
            <h2 style="text-align: center; margin-top: 5px; font-weight: bold; font-size: 30px;">Employee Report by Company</h2>
        </div>
    </div>

    <div style="position: relative">
        <div class="row">
            <div class="col-md-4"><%--style="margin-top: 12px;"--%>
                <a href="Home_Page.aspx" id="A1" runat="server" style="font-size:large;">
                    Home
                </a><br /><br />
                <a href="Daily_Report.aspx" id="A2" runat="server">
                    Daily Report
                </a>
                &nbsp; &nbsp; &nbsp;
                 <a href="Employee_Report.aspx" id="A3" runat="server">
                    Employee Report
                </a>
                &nbsp; &nbsp; &nbsp;
                 <a href="Project_Report.aspx" id="A4" runat="server">
                    Project Report
                </a>
            </div>
            <div class="col-md-4" style="text-align: center; margin-top:-7px;">
                <asp:Label Font-Bold="true" Font-Size="X-Large" Text="Company Report" runat="server" />
            </div>
        </div>
    </div>

    <div class="panel panel-default" id="Div1" runat="server" style="margin-top: 0px; height: 80%;">
        <div class="panel-body" style="margin-top: 0px; height: 80%;">
            
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">

                        <div class="row">
                            <label id="lblpower" runat="server"></label>
                            <div class="col-md-3">
                                <label>Business Name</label>
                                <asp:DropDownList ID="ddlBusiness" Width="100%" ClientIDMode="Static" required runat="server" CssClass="form-control" AppendDataBoundItems="true">
                                    <asp:ListItem Text="Select" Value=""></asp:ListItem>
                                </asp:DropDownList>
                                <asp:HiddenField ID="hfSelected" runat="server" />

                                <asp:HiddenField ID="hdnDate" runat="server" />
                                <asp:HiddenField ID="hdnDate1" runat="server" />

                            </div>

                            <div class="col-md-3">
                                <label>Report Status</label>
                                <asp:DropDownList ID="DropDownList_Report_Status" Width="100%" ClientIDMode="Static" required runat="server" CssClass="form-control" AppendDataBoundItems="true">
                                    <asp:ListItem Text="All" Value="0"></asp:ListItem>
                                    <asp:ListItem Text="Approved" Value="2"></asp:ListItem>
                                    <asp:ListItem Text="Rejected" Value="3"></asp:ListItem>
                                    <asp:ListItem Text="Absent" Value="4"></asp:ListItem>
                                    <asp:ListItem Text="Pending" Value="1"></asp:ListItem>
                                </asp:DropDownList>
                            </div>

                            
                        </div>


                    </div>
                </div>
            </div>


        </div>
    </div>

    <div class="panel panel-default" runat="server" style="background-color: #ECF0F3">
        <div class="panel-body">

            <div class="row" style="background-color: #ECF0F3">
                <div class="col-md-12">
                    <div class="form-group">
                        <div class="row">
                            
                            <div class="col-md-3">
                               
                                <label>Date Range</label>
                                <asp:DropDownList ID="ddrange" runat="server" AutoPostBack="true" CssClass="form-control" OnSelectedIndexChanged="ddrange_SelectedIndexChanged">
                                    <asp:ListItem Value="Select" Text="Select"></asp:ListItem>
                                    <asp:ListItem Value="Weekly" Text="Weekly"></asp:ListItem>
                                    <asp:ListItem Value="Last 4 Weeks" Text="Last 4 Weeks"></asp:ListItem>
                                    <asp:ListItem Value="Last 30 Days" Text="Last 30 Days"></asp:ListItem>
                                    <asp:ListItem Value="Last 60 Days" Text="Last 60 Days"></asp:ListItem>
                                    <asp:ListItem Value="Last 90 Days" Text="Last 90 Days"></asp:ListItem>
                                    <asp:ListItem Value="Monthly" Text="Monthly"></asp:ListItem>
                                    <asp:ListItem Value="Custom" Selected="True" Text="Custom"></asp:ListItem>
                                </asp:DropDownList>
                                <asp:HiddenField ID="hdnrange" runat="server" />
                            </div>


                            <div class="col-md-2">
                                <label>From Date</label>
                                <asp:TextBox ID="txtFromDate" ClientIDMode="Static" runat="server" type="date" CssClass="form-control" Max="9999-12-31"></asp:TextBox>
                                <asp:HiddenField ID="hdnfrmdt" runat="server" />

                            </div>


                            <div class="col-md-2">
                                <label>To Date</label>
                                <asp:TextBox ID="txtToDate" runat="server" ClientIDMode="Static" type="date" CssClass="form-control" Max="9999-12-31"></asp:TextBox>
                                <asp:HiddenField ID="hdntodt" runat="server" />

                            </div>


                            <div class="col-md-2">
                                <label>&nbsp;</label>
                                <asp:Button ID="btnshow" runat="server" Text="Update Report" class="buttonhyperlink"
                                     OnClick="btnshow_Click" /> <%--Width="100%"--%>
                            </div>

                            <div class="col-md-2">
                                <label>&nbsp;</label>
                                <div class="dropdown">
                                    <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" style="background-color: #ECF0F3; border-radius: 0px; border: 1px solid #607DF2; color: black; font-family: sans-serif; font-size: small;" aria-expanded="true">
                                        Download Report
    <span class="caret"></span>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                        <li>
                                            <asp:LinkButton ID="lnkExcel" runat="server" Text="Excel" OnClick="lnkExcel_Click"></asp:LinkButton></li>
                                        <li>
                                            <asp:LinkButton ID="lnkDirectPdf" runat="server" Text="PDF" OnClick="lnkDirectPdf_Click"></asp:LinkButton></li>

                                        <li>
                                            <asp:LinkButton ID="lnkCsvFile" runat="server" Visible="false" Text="CSV" OnClick="lnkCsvFile_Click"></asp:LinkButton></li>

                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            
                            <div class="col-md-3">
                                <asp:LinkButton ID="lnkbtn" OnClick="lnkbtn_Click" runat="server" Visible="false" Text="Compare to prior period"></asp:LinkButton>
                                <asp:HiddenField ID="hdnvisible" runat="server" Value="NO" />
                            </div>
                        </div>
                        <div class="row" style="background-color: #ECF0F3" id="divrange2" runat="server">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="row">
                                        <div class="col-md-2" style="padding: 5px; text-align: right;">
                                            <label style="font-weight: bold; font-size: 16px; color: black; text-transform: capitalize;">Date Range 2</br>(Prior Period)</label>
                                        </div>
                                        <div class="col-md-3">
                                            <asp:DropDownList ID="ddrange2" runat="server" AutoPostBack="true" CssClass="form-control" OnSelectedIndexChanged="ddrange2_SelectedIndexChanged">
                                                <asp:ListItem Value="Select" Text="Select"></asp:ListItem>
                                                <asp:ListItem Value="Weekly" Text="Weekly"></asp:ListItem>
                                                <asp:ListItem Value="Last 4 Weeks" Text="Last 4 Weeks"></asp:ListItem>
                                                <asp:ListItem Value="Last 30 Days" Text="Last 30 Days"></asp:ListItem>
                                                <asp:ListItem Value="Last 60 Days" Text="Last 60 Days"></asp:ListItem>
                                                <asp:ListItem Value="Last 90 Days" Text="Last 90 Days"></asp:ListItem>
                                                <asp:ListItem Value="Monthly" Text="Monthly"></asp:ListItem>
                                                <asp:ListItem Value="Custom" Text="Custom"></asp:ListItem>
                                            </asp:DropDownList>
                                            <asp:HiddenField ID="hdnrange2" runat="server" />
                                        </div>


                                        <div class="col-md-1">
                                            <asp:TextBox ID="txtFromDate2" type="date" required runat="server" class="text" Max="9999-12-31"></asp:TextBox>
                                            <asp:HiddenField ID="hdnfrmdt2" runat="server" />

                                        </div>


                                        <div class="col-md-1">

                                            <asp:TextBox ID="txtToDate2" type="date" required runat="server" class="text" Max="9999-12-31"></asp:TextBox>
                                            <asp:HiddenField ID="HiddenField3" runat="server" />
                                            <asp:HiddenField ID="hdntodt2" runat="server" />
                                        </div>



                                        <div class="col-md-1">

                                            <asp:ImageButton ID="ImageButton2" runat="server" formnovalidate="formnovalidate" ImageUrl="~/images/delete3.png"
                                                OnClick="ImageButton2_Click" Height="27px" Width="29px" />
                                        </div>
                                        <div class="col-md-2">
                                            <asp:HiddenField ID="hdndate3" runat="server" />
                                            <asp:HiddenField ID="hdndate4" runat="server" />
                                        </div>

                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>


    <div class="panel panel-default" runat="server" id="pnlhideandshow">
        <div class="panel-body">

           

            <div class="row">
                <div class="col-md-12">
                    <div style="overflow-x: auto;">
            <asp:GridView ID="GVBusiness" ClientIDMode="Static" runat="server" Width="100%"
                CssClass="table nowrap" AutoGenerateColumns="False" EmptyDataText="No records Found" OnPreRender="GVBusiness_PreRender" Visible="false"
                OnPageIndexChanging="GVBusiness_PageIndexChanging" OnRowCommand="GVBusiness_RowCommand" CellPadding="4" ForeColor="#333333" GridLines="None">

                <%--<HeaderStyle CssClass="bg-clouds" />--%>

                <AlternatingRowStyle BackColor="LightGray" />

                <Columns>

                    <asp:TemplateField HeaderText="Sl. No.">
                        <ItemTemplate>
                            <%#Container.DataItemIndex + 1%>
                        </ItemTemplate>
                    </asp:TemplateField>
                    <asp:TemplateField HeaderText="User Name">
                        <ItemTemplate>
                            <asp:Label ID="lblEmployeeName" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Employee Name")%>' />
                            <asp:HiddenField ID="hdnempid" runat="server"  Value='<%#DataBinder.Eval(Container.DataItem, "EmployeeID")%>' />
                        </ItemTemplate>
                    </asp:TemplateField>

                    <asp:TemplateField HeaderText="Gross Hours">
                        <ItemTemplate>
                            <asp:Label ID="LblRegular" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Gross Hours")%>' />
                        </ItemTemplate>
                    </asp:TemplateField>


                    <asp:TemplateField HeaderText="Break Time">
                        <ItemTemplate>
                            <asp:Label ID="LblBreakTotal" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Break Time")%>' />
                        </ItemTemplate>

                    </asp:TemplateField>

                    <asp:TemplateField HeaderText="Net Hours">
                        <ItemTemplate>
                            <asp:Label ID="LblTotal" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Net Hours & Minutes")%>' />
                        </ItemTemplate>
                    </asp:TemplateField>

                   
                    <asp:TemplateField HeaderText="View Report">
                        <ItemTemplate>
                            
                            <div class="dropdown">
                                <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" style="background-color: #ECF0F3; border-radius: 0px; border: 1px solid #607DF2; color: black; font-family: sans-serif; font-size: small;" aria-expanded="true">
                                    Download Report
    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                    <li>
                                        <asp:LinkButton ID="lnkGvExcel" runat="server" Text="Excel" CommandName="Excel" CommandArgument='<%# Container.DataItemIndex %>'></asp:LinkButton></li>
                                    <li>
                                        <asp:LinkButton ID="lnkPdf" runat="server" Text="PDF" CommandName="PDF" CommandArgument='<%# Container.DataItemIndex %>'></asp:LinkButton></li>
                                     <li>
                                        <asp:LinkButton ID="lnkCsv" runat="server" Text="CSV" Visible="false" CommandName="CSV" CommandArgument='<%# Container.DataItemIndex %>'></asp:LinkButton></li>

                                </ul>
                            </div>
                        </ItemTemplate>
                    </asp:TemplateField>
                </Columns>
                <EditRowStyle BackColor="#2461BF" />
                <EmptyDataTemplate>
                    <div>No records found.</div>
                </EmptyDataTemplate>
                <PagerStyle HorizontalAlign="Right" CssClass="GridPager" />
                <RowStyle BackColor="white" />


            </asp:GridView>
                    </div>
                </div>
            </div>


            <div class="col-md-12">
                <div class="row">

                    <div class="col-md-6" style="text-align: left; justify-content: left; justify-items: left;">


                        <asp:GridView ID="GV" ClientIDMode="Static" runat="server" Width="100%"
                            CssClass="table nowrap" AutoGenerateColumns="False" EmptyDataText="No records Found" OnPreRender="GV_PreRender" Visible="false"
                            AllowPaging="True" OnPageIndexChanging="GV_PageIndexChanging" OnRowCommand="GV_RowCommand" CellPadding="4" ForeColor="#333333" GridLines="None">

                            <%--<HeaderStyle CssClass="bg-clouds" />--%>

                            <AlternatingRowStyle BackColor="LightGray" />

                            <Columns>
                                <asp:TemplateField HeaderText="Date">
                                    <ItemTemplate>
                                        <asp:Label ID="lbldate" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Date")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>
                                <asp:TemplateField HeaderText="Day">
                                    <ItemTemplate>
                                        <asp:Label ID="lbldate" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Day")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>
                                <asp:TemplateField HeaderText="User Name">
                                    <ItemTemplate>
                                        <asp:Label ID="lblEmployeeName" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "empname")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>
                                <asp:TemplateField HeaderText="Gross Hours">
                                    <ItemTemplate>
                                        <asp:Label ID="LblRegular" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Gross Hours")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>


                                <asp:TemplateField HeaderText="Break Time">
                                    <ItemTemplate>
                                        <asp:Label ID="LblBreakTotal" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Break Time")%>' />
                                    </ItemTemplate>

                                </asp:TemplateField>

                                <asp:TemplateField HeaderText="Net Hours">
                                    <ItemTemplate>
                                        <asp:Label ID="LblTotal" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Net")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>


                            </Columns>
                            <EditRowStyle BackColor="#2461BF" />
                            <EmptyDataTemplate>
                                <div>No records found.</div>
                            </EmptyDataTemplate>

                            <RowStyle BackColor="white" />


                        </asp:GridView>

                    </div>
                    <div class="col-md-6">

                        <asp:GridView ID="GVCompare2" ClientIDMode="Static" runat="server" Width="100%"
                            CssClass="table nowrap" AutoGenerateColumns="False" EmptyDataText="No records Found" OnPreRender="GVCompare2_PreRender" Visible="false"
                            AllowPaging="True" OnPageIndexChanging="GVCompare2_PageIndexChanging" ForeColor="#333333" GridLines="None">
                            <PagerStyle HorizontalAlign="Center" />

                            <%--<HeaderStyle CssClass="bg-clouds" />--%>

                            <AlternatingRowStyle BackColor="LightGray" />

                            <Columns>
                                <asp:TemplateField HeaderText="Date">
                                    <ItemTemplate>
                                        <asp:Label ID="lbldate2" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Date")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>
                                <asp:TemplateField HeaderText="Day">
                                    <ItemTemplate>
                                        <asp:Label ID="lblday2" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Day")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>
                                <asp:TemplateField HeaderText="User Name">
                                    <ItemTemplate>
                                        <asp:Label ID="lblEmployeeName2" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "empname")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>


                                <asp:TemplateField HeaderText="Net Hours">
                                    <ItemTemplate>
                                        <asp:Label ID="LblTotal2" runat="server" Text='<%#DataBinder.Eval(Container.DataItem, "Net")%>' />
                                    </ItemTemplate>
                                </asp:TemplateField>



                            </Columns>
                            <EditRowStyle BackColor="#2461BF" />
                            <EmptyDataTemplate>
                                <div>No records found.</div>
                            </EmptyDataTemplate>

                            <RowStyle BackColor="white" />


                        </asp:GridView>

                        <asp:GridView ID="GvExport" runat="server">
                            
                        </asp:GridView>

                    </div>
                </div>

            </div>

            <asp:GridView runat="server" ID="GvExport1" CellPadding="4" ForeColor="#333333"  CellSpacing="4">
                <AlternatingRowStyle BackColor="LightGray" HorizontalAlign="Center" />
                <EditRowStyle BackColor="#2461BF" />
                <FooterStyle BackColor="#507CD1" Font-Bold="True" ForeColor="White" />
                <HeaderStyle BackColor="#507CD1" Font-Bold="True" ForeColor="White" />
                <PagerStyle BackColor="#2461BF" ForeColor="White" HorizontalAlign="Center" />
                <RowStyle BackColor="white" HorizontalAlign="Center" />
                <SelectedRowStyle BackColor="#D1DDF1" Font-Bold="True" ForeColor="#333333" />
                <SortedAscendingCellStyle BackColor="#F5F7FB" />
                <SortedAscendingHeaderStyle BackColor="#6D95E1" />
                <SortedDescendingCellStyle BackColor="#E9EBEF" />
                <SortedDescendingHeaderStyle BackColor="#4870BE" />
            </asp:GridView>

        </div>
    </div>

</asp:Content>