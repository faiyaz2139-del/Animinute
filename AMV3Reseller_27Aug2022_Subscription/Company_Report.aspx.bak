    <script>
        $(document).ready(function () {
            $('#GV').DataTable({
            });
            $('#GVCompare1').DataTable({
            });

            $('#multi-filter-select').DataTable({
                "pageLength": 5,
                initComplete: function () {
                    this.api().columns().every(function () {
                        var column = this;
                        var select = $('<select class="form-control"><option value=""></option></select>')
                            .appendTo($(column.footer()).empty())
                            .on('change', function () {
                                var val = $.fn.dataTable.util.escapeRegex(
                                    $(this).val()
                                );

                                column
                                    .search(val ? '^' + val + '$' : '', true, false)
                                    .draw();
                            });

                        column.data().unique().sort().each(function (d, j) {
                            select.append('<option value="' + d + '">' + d + '</option>')
                        });
                    });
                }
            });

            // Add Row
            $('#add-row').DataTable({
                "pageLength": 5,
            });

            var action = '<td> <div class="form-button-action"> <button type="button" data-toggle="tooltip" title="" class="btn btn-link btn-primary btn-lg" data-original-title="Edit Task"> <i class="fa fa-edit"></i> </button> <button type="button" data-toggle="tooltip" title="" class="btn btn-link btn-danger" data-original-title="Remove"> <i class="fa fa-times"></i> </button> </div> </td>';

            $('#addRowButton').click(function () {
                $('#add-row').dataTable().fnAddData([
                    $("#addName").val(),
                    $("#addPosition").val(),
                    $("#addOffice").val(),
                    action
                ]);
                $('#addRowModal').modal('hide');

            });
        });
    </script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
    <script src="Assets/assets/js/SweetAlert.js"></script>
    <script type="text/javascript" src='https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js'></script>
    <script type="text/javascript" src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.25.1/moment.min.js"></script>
    <link type="text/css" rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" />
    <script>
        $(document).ready(function () {
            $('#ddlBusiness').on('change', function () {
                $('#<%=hfSelected.ClientID%>').val($(this).val());
            });
        });
    </script>

    <!-- JavaScript code to add a date to the date control -->
    <script type="text/javascript">
        $(document).ready(function () {

            var index = $("#<%=hdnrange.ClientID%>").val();
            if (index == 0) {
                //// Get today's date
                //const today = new Date();

                //// Add 7 days to today's date
                //const daysToAdd = 0;
                //const newDate = new Date(today);
                //newDate.setDate(today.getDate() + daysToAdd);

                //// Format the new date as YYYY-MM-DD
                //const formattedDate = newDate.toISOString().substr(0, 10);

                //// Set the date input's value to the new date
                //const dateInput = document.getElementById("txtToDate");
                //dateInput.value = formattedDate;

                //// const today = new Date();
                //const formattedFirstDate = today.toISOString().substr(0, 10);

                //// Set the date input's value to the new date
                //const TodaydateInput = document.getElementById("txtFromDate");
                //TodaydateInput.value = formattedFirstDate;
            }

            if (index == 1) {
                // Get today's date
                const today = new Date();

                // Add 7 days to today's date
                const daysToAdd = 6;
                const newDate = new Date(today);
                newDate.setDate(today.getDate() - daysToAdd);

                // Format the new date as YYYY-MM-DD
                const formattedDate = newDate.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const dateInput = document.getElementById("txtFromDate");
                dateInput.value = formattedDate;

                // const today = new Date();
                const formattedFirstDate = today.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const TodaydateInput = document.getElementById("txtToDate");
                TodaydateInput.value = formattedFirstDate;
            }

            if (index == 2) {
                // Get today's date
                const today = new Date();

                // Add 7 days to today's date
                const daysToAdd = 28;
                const newDate = new Date(today);
                newDate.setDate(today.getDate() - daysToAdd);

                // Format the new date as YYYY-MM-DD
                const formattedDate = newDate.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const dateInput = document.getElementById("txtFromDate");
                dateInput.value = formattedDate;

                // const today = new Date();
                const formattedFirstDate = today.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const TodaydateInput = document.getElementById("txtToDate");
                TodaydateInput.value = formattedFirstDate;
            }

            if (index == 3) {
                // Get today's date
                const today = new Date();

                // Add 7 days to today's date
                const daysToAdd = 29;
                const newDate = new Date(today);
                newDate.setDate(today.getDate() - daysToAdd);

                // Format the new date as YYYY-MM-DD
                const formattedDate = newDate.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const dateInput = document.getElementById("txtFromDate");
                dateInput.value = formattedDate;

                // const today = new Date();
                const formattedFirstDate = today.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const TodaydateInput = document.getElementById("txtToDate");
                TodaydateInput.value = formattedFirstDate;
            }

            if (index == 4) {
                // Get today's date
                const today = new Date();

                // Add 7 days to today's date
                const daysToAdd = 59;
                const newDate = new Date(today);
                newDate.setDate(today.getDate() - daysToAdd);

                // Format the new date as YYYY-MM-DD
                const formattedDate = newDate.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const dateInput = document.getElementById("txtFromDate");
                dateInput.value = formattedDate;

                // const today = new Date();
                const formattedFirstDate = today.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const TodaydateInput = document.getElementById("txtToDate");
                TodaydateInput.value = formattedFirstDate;
            }

            if (index == 5) {
                // Get today's date
                const today = new Date();

                // Add 7 days to today's date
                const daysToAdd = 89;
                const newDate = new Date(today);
                newDate.setDate(today.getDate() - daysToAdd);

                // Format the new date as YYYY-MM-DD
                const formattedDate = newDate.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const dateInput = document.getElementById("txtFromDate");
                dateInput.value = formattedDate;

                // const today = new Date();
                const formattedFirstDate = today.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const TodaydateInput = document.getElementById("txtToDate");
                TodaydateInput.value = formattedFirstDate;
            }
            if (index == 6) {
                // Get today's date
                const today = new Date();

                // Get the year and month of today's date
                const year = today.getFullYear();
                const month = today.getMonth();

                // Create a new date object set to the first day of the current month
                const firstDayOfMonth = new Date(year, month, 2);

                // Format the first day of the month as YYYY-MM-DD
                const formattedDate = firstDayOfMonth.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const dateInput = document.getElementById("txtFromDate");
                dateInput.value = formattedDate;

                // Get today's date
                const today1 = new Date();

                // Get the last day of the current month
                const lastDayOfMonth = new Date(today1.getFullYear(), today1.getMonth() + 1, 1);

                // Format the last day of the month as YYYY-MM-DD
                const formattedLastDate = lastDayOfMonth.toISOString().substr(0, 10);

                // Set the date input's value to the new date
                const LastdateInput = document.getElementById("txtToDate");
                LastdateInput.value = formattedLastDate;
            }
        });
    </script>

