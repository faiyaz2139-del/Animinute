<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="WeekTimeCard.aspx.cs" Inherits="AnyminuteWeekTimeCard" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><style id="am-clockout-spacing-20261019">
/* Keep a visible gap even when the clock-out cell wraps on a small screen. */
.am-week td label.am-next-day-gap {
 display:inline-flex; align-items:center; gap:5px;
 margin-inline-start:12px; margin-block:6px; white-space:nowrap;
 vertical-align:middle;
}
.am-week td label.am-next-day-gap input[type="checkbox"] {
 width:auto; min-width:0; margin:0; flex:none;
}
</style><script src="Scripts/AnyminuteBreaks.js"></script></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><section class="am-card"><div class="am-title"><div><h1>Weekly Time Card</h1><p>Enter daily time, review breaks and approve the week. Times use the business time zone.</p></div><asp:Literal ID="Badge" runat="server" /></div>
<div class="am-toolbar am-week-selection"><asp:PlaceHolder ID="BusinessField" runat="server" Visible="false"><label><span>Business</span><asp:DropDownList ID="BusinessPick" runat="server" AutoPostBack="true" OnSelectedIndexChanged="BusinessChanged" /></label></asp:PlaceHolder><label><span>Employee</span><asp:DropDownList ID="Employee" runat="server" AutoPostBack="true" OnSelectedIndexChanged="SelectionChanged" /></label><label><span>Week starting &#183; Monday&#8211;Sunday</span><asp:TextBox ID="Week" runat="server" TextMode="Date" AutoPostBack="true" OnTextChanged="SelectionChanged" /></label><div class="am-actions"><asp:Button ID="SaveTop" runat="server" Text="Save changes" OnClick="Save_Click" CssClass="am-button" /><asp:Button ID="SubmitTop" runat="server" Text="Submit Week" OnClick="Submit_Click" CssClass="am-button secondary" /><asp:Button ID="Copy" runat="server" Text="Copy Monday to weekdays" OnClick="Copy_Click" OnClientClick="return confirm('Copy saved Monday to empty weekdays? Existing and approved entries will be preserved.');" /></div></div>
<p class="am-week-help">Save changes stores a draft. Submit Week sends the saved week for approval and locks editing until it is returned.</p><asp:Label ID="Message" runat="server" CssClass="am-notice am-toast" Visible="false" />
<div class="am-summary"><div><label>Net hours</label><strong><asp:Literal ID="NetHours" runat="server" /></strong></div><div><label>Unpaid / paid breaks</label><strong><asp:Literal ID="BreakHours" runat="server" /></strong></div><div><label>Recorded overtime</label><strong><asp:Literal ID="Overtime" runat="server" /></strong></div><div><label>Estimated base pay</label><strong><asp:Literal ID="BasePay" runat="server" /></strong><small class="am-muted">Daily effective hourly rates &#183; before adjustments</small></div></div>
<div class="am-table-wrap"><table class="am-table am-week"><thead><tr><th>Day</th><th>Attendance</th><th>Clock in</th><th>Clock out</th><th>Unpaid / paid break</th><th>Net hours</th><th>Status</th><th>Action</th></tr></thead><tbody>
<asp:Repeater ID="Days" runat="server" OnItemCommand="DayCommand"><ItemTemplate><tr><td><strong><%#: Eval("Day") %></strong><small class="am-muted"><%#: Eval("Date","{0:MMM d}") %></small><asp:HiddenField ID="DateKey" runat="server" Value='<%# Eval("Date","{0:yyyy-MM-dd}") %>' /></td><td><asp:DropDownList ID="Worked" runat="server" Enabled='<%# Convert.ToBoolean(Eval("Editable")) %>' SelectedValue='<%# Eval("Worked") %>'><asp:ListItem Value="">Not entered</asp:ListItem><asp:ListItem Value="Yes">Worked</asp:ListItem><asp:ListItem Value="No">Day Off</asp:ListItem></asp:DropDownList></td><td><asp:TextBox ID="Start" runat="server" TextMode="Time" Text='<%# Eval("Start") %>' Enabled='<%# Convert.ToBoolean(Eval("Editable")) %>' /></td><td class="am-clock-out-cell"><div class="am-clock-out-group"><asp:TextBox ID="End" runat="server" TextMode="Time" Text='<%# Eval("End") %>' Enabled='<%# Convert.ToBoolean(Eval("Editable")) %>' /><label class="am-muted am-next-day-gap"><asp:CheckBox ID="NextDay" runat="server" Checked='<%# Convert.ToBoolean(Eval("NextDay")) %>' Enabled='<%# Convert.ToBoolean(Eval("Editable")) %>' /> Next day</label></div></td><td><strong><%#: Eval("BreakDisplay") %></strong><asp:LinkButton ID="Breaks" runat="server" Text="View / edit breaks" CommandName="Breaks" CommandArgument='<%# Eval("Date","{0:yyyy-MM-dd}") %>' /></td><td><strong><%#: Eval("Net") %></strong><asp:Literal runat="server" Text='<%# Eval("EstimateNote") %>' /></td><td><span class='<%# "am-badge "+Eval("Status") %>'><%#: Eval("Status") %></span></td><td><asp:Button ID="ApproveDay" runat="server" CssClass="am-button secondary" Text="&#10003; Approve Day" CommandName="ApproveDay" CommandArgument='<%# Eval("Date","{0:yyyy-MM-dd}") %>' Visible='<%# Convert.ToBoolean(Eval("Reviewable")) %>' /><asp:Button ID="ConfirmEstimate" runat="server" CssClass="am-button secondary" Text="Confirm estimate" CommandName="ConfirmEstimate" CommandArgument='<%# Eval("Date","{0:yyyy-MM-dd}") %>' Visible='<%# Convert.ToBoolean(Eval("EstimateAvailable")) %>' /></td></tr></ItemTemplate></asp:Repeater></tbody></table></div>
<div class="am-review-bottom"><div><strong><asp:Literal ID="ProgressLabel" runat="server" /></strong><asp:Literal ID="ProgressBar" runat="server" /><small class="am-muted">You can review individual days or approve all valid submitted entries together.</small><p class="am-muted">Breaks display hours:minutes. Paid breaks remain payable.</p></div><div><label>Manager comments</label><asp:TextBox ID="Comment" runat="server" TextMode="MultiLine" MaxLength="1000" placeholder="Optional for approval; required when returning or reopening a week." /><asp:Literal ID="ApprovalInfo" runat="server" /></div></div>
<div class="am-actions" style="margin-top:20px"><asp:Button ID="Save" runat="server" Text="Save Draft" OnClick="Save_Click" /><asp:Button ID="Submit" runat="server" Text="Submit Week" OnClick="Submit_Click" OnClientClick="return confirm('Submit your saved week for review? Editing will be locked until it is returned.');" /><asp:Button ID="Approve" runat="server" Text="&#10003; Approve Week" CssClass="am-button approve" OnClick="Approve_Click" /><asp:Button ID="Reject" runat="server" Text="Return for Correction" CssClass="am-button danger" OnClick="Reject_Click" /><asp:Button ID="Reopen" runat="server" Text="Reopen Approved Week" CssClass="am-button danger" OnClick="Reopen_Click" /></div>
<p class="am-muted">Save changes before submitting. Clock-out estimates require confirmation and are never payroll evidence by themselves.</p>
</section>
<asp:Panel ID="BreakModal" runat="server" CssClass="am-modal am-break-modal" Visible="false"><section class="am-card" role="dialog" aria-modal="true" aria-label="Manage Breaks">
<header class="am-break-header"><button type="button" class="am-icon-button am-overlay-close" data-close-modal aria-label="Close">&#215;</button><h2>Manage Breaks</h2><asp:Label ID="BreakDay" runat="server" /></header>
<div class="am-break-body"><asp:Label ID="BreakMessage" runat="server" CssClass="am-notice am-error" Visible="false" /><div class="am-summary am-break-summary"><div><label>Work Time</label><strong><asp:Literal ID="BreakWorkTime" runat="server" /></strong></div><div><label>Total Hours</label><strong><asp:Literal ID="BreakGross" runat="server" /></strong></div><div><label>Unpaid Break</label><strong class="am-unpaid"><asp:Literal ID="BreakUnpaid" runat="server" /></strong></div><div><label>Paid Break</label><strong class="am-paid"><asp:Literal ID="BreakPaid" runat="server" /></strong></div><div><label>Net Hours</label><strong><asp:Literal ID="BreakNet" runat="server" /></strong></div></div>
<section class="am-break-entry"><h3>Add or Edit Break</h3><div class="am-break-fields"><label>Break Start Time<asp:TextBox ID="BreakStart" runat="server" TextMode="Time" CssClass="am-break-start" /></label><label>Break End Time<asp:TextBox ID="BreakEnd" runat="server" TextMode="Time" CssClass="am-break-end" /></label><label>Break Type<asp:RadioButtonList ID="Paid" runat="server" RepeatDirection="Horizontal"><asp:ListItem Value="0" Selected="true">Unpaid</asp:ListItem><asp:ListItem Value="1">Paid</asp:ListItem></asp:RadioButtonList></label><label>Duration (HH:MM)<input class="am-break-duration" readonly value="&#8212;" aria-label="Calculated break duration" /></label></div><div class="am-actions"><asp:Button ID="SaveBreak" runat="server" Text="&#65291; Add Break" OnClick="SaveBreak_Click" /><asp:Button ID="CancelBreakEdit" runat="server" Text="Cancel Edit" OnClick="CancelBreakEdit_Click" CssClass="am-button secondary" /></div><p class="am-muted">24-hour time. Duration is calculated automatically. Breaks must stay within the saved shift and cannot overlap. Each add, update or delete saves immediately.</p></section>
<h3>Recorded Breaks</h3><div class="am-table-wrap"><table class="am-table"><thead><tr><th>#</th><th>Break Start</th><th>Break End</th><th>Break Type</th><th>Duration</th><th>Action</th></tr></thead><tbody><asp:Repeater ID="BreakRows" runat="server" OnItemCommand="BreakCommand"><ItemTemplate><tr><td><%# Container.ItemIndex+1 %></td><td><%#: Convert.ToDateTime(Eval("BreakStart")).ToString("HH:mm") %></td><td><%#: Convert.ToDateTime(Eval("BreakEnd")).ToString("HH:mm") %></td><td><span class='<%# Convert.ToBoolean(Eval("IsPaid"))?"am-badge am-paid-badge":"am-badge am-unpaid-badge" %>'><%#: Convert.ToBoolean(Eval("IsPaid"))?"Paid":"Unpaid" %></span></td><td><%#: AnyminuteReportDurations.Format(AnyminuteReportDurations.Parse(Eval("BreakTotal"))) %></td><td><div class="am-actions"><asp:LinkButton runat="server" Text="Edit" Visible='<%# CanEditBreaks %>' CommandName="Edit" CommandArgument='<%# Eval("BreakID") %>' /><asp:LinkButton runat="server" Text="Delete" Visible='<%# CanEditBreaks %>' CommandName="Delete" CommandArgument='<%# Eval("BreakID") %>' OnClientClick="return confirm('Delete this break?');" /></div></td></tr></ItemTemplate></asp:Repeater></tbody></table></div>
<div class="am-summary am-break-totals"><div><label>Total Unpaid Break</label><strong><asp:Literal ID="TotalUnpaidBreak" runat="server" /></strong></div><div><label>Total Paid Break</label><strong><asp:Literal ID="TotalPaidBreak" runat="server" /></strong></div></div><footer class="am-actions"><button type="button" class="am-button secondary" data-close-modal>Done</button></footer></div></section></asp:Panel>
</asp:Content>
