<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="Dashboard.aspx.cs" Inherits="AnyminuteDashboard" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link href="css/AnyminuteFlash.css?v=20261024v2" rel="stylesheet" /><link href="css/AnyminuteRoleDashboard.css?v=20261031v36" rel="stylesheet" /><link href="css/AnyminuteAccountantDashboard.css?v=20261031v37" rel="stylesheet" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<asp:Panel ID="SavedFlash" runat="server" Visible="false" CssClass="am-flash" role="status" aria-live="polite" ClientIDMode="Static" tabindex="-1"><span class="am-flash-icon" aria-hidden="true">&#10003;</span><asp:Literal ID="SavedFlashText" runat="server" /><button type="button" class="am-flash-close" aria-label="Dismiss message" onclick="this.parentNode.style.display='none';">&times;</button></asp:Panel><script>document.addEventListener("DOMContentLoaded",function(){var f=document.getElementById("SavedFlash");if(f){f.focus();}});</script>
<asp:Literal ID="RoleDashboard" runat="server" Visible="false" />
<asp:PlaceHolder ID="OwnerView" runat="server">
<div class="am-dashboard-overview"><div class="am-stats">
<a class="am-card am-stat am-stat-link" href="Dashboard.aspx?view=businesses"><span class="am-stat-icon" data-am-icon="business" aria-hidden="true"></span><div><small>Total Businesses</small><strong><asp:Literal ID="BusinessCount" runat="server" /></strong><small>Businesses you can access</small></div></a>
<a class="am-card am-stat am-stat-link" href="Users.aspx"><span class="am-stat-icon" data-am-icon="people" aria-hidden="true"></span><div><small>Total Employees</small><strong><asp:Literal ID="EmployeeCount" runat="server" /></strong><small>Within your access</small></div></a>
<a class="am-card am-stat am-stat-link" id="ApprovalCard" runat="server" href="TimeCards.aspx?status=Submitted"><span class="am-stat-icon" data-am-icon="clock" aria-hidden="true"></span><div><small><asp:Literal ID="ApprovalTitle" runat="server" Text="Pending Approvals" /></small><strong><asp:Literal ID="ApprovalCount" runat="server" /></strong><small><asp:Literal ID="ApprovalHint" runat="server" Text="Submitted timecards" /></small></div></a>
<a class="am-card am-stat am-stat-link" href="Projects.aspx"><span class="am-stat-icon" data-am-icon="folder" aria-hidden="true"></span><div><small>Active Projects</small><strong><asp:Literal ID="ProjectCount" runat="server" /></strong><small>Within your access</small></div></a>
</div>
</div>
<asp:Label ID="StatusMessage" runat="server" Visible="false" CssClass="am-notice" role="status" />
<section class="am-card" id="businesses"><div class="am-title am-businesses-header"><div><h1>Businesses</h1><p><asp:Literal ID="BusinessesIntro" runat="server" Text="Manage your businesses, projects, users and timecards." /></p></div><section class="am-card am-quick-actions" aria-labelledby="quick-actions-title"><h2 id="quick-actions-title">Quick Actions</h2><div class="am-quick-grid">
<asp:HyperLink ID="AddBusiness" runat="server" NavigateUrl="~/Add_Business.aspx" CssClass="am-button secondary"><span data-am-icon="business" aria-hidden="true"></span>Add Business</asp:HyperLink>
<asp:HyperLink ID="AddUser" runat="server" NavigateUrl="~/EmployeeEditor.aspx" CssClass="am-button secondary"><span data-am-icon="people" aria-hidden="true"></span>Add Employee</asp:HyperLink>
<asp:HyperLink ID="ViewApprovals" runat="server" NavigateUrl="~/TimeCards.aspx?status=Submitted" CssClass="am-button secondary"><span data-am-icon="check" aria-hidden="true"></span>View Approvals</asp:HyperLink>
<asp:HyperLink ID="TimeCardQuick" runat="server" Visible="false" NavigateUrl="~/WeekTimeCard.aspx" CssClass="am-button secondary"><span data-am-icon="clock" aria-hidden="true"></span>My Time Card</asp:HyperLink>
<asp:HyperLink ID="WorkScheduleQuick" runat="server" Visible="false" NavigateUrl="~/WeeklyEmployeeSchedule.aspx" CssClass="am-button secondary"><span data-am-icon="dashboard" aria-hidden="true"></span>Work Schedule</asp:HyperLink>
<asp:HyperLink ID="ReportsQuick" runat="server" Visible="false" CssClass="am-button secondary"><span data-am-icon="reports" aria-hidden="true"></span>Reports</asp:HyperLink>
</div></section></div>
<div class="am-toolbar"><label><span>Search businesses</span><input type="search" data-search="#business-grid" placeholder="Business or contact name&#8230;" /></label><label><span>Status</span><asp:DropDownList ID="StatusFilter" runat="server" AutoPostBack="true" OnSelectedIndexChanged="FilterChanged"><asp:ListItem Value="All">All statuses</asp:ListItem><asp:ListItem Value="Active">Active</asp:ListItem><asp:ListItem Value="Inactive">Not Active</asp:ListItem></asp:DropDownList></label></div>
<div class="am-table-wrap"><table class="am-table" id="business-grid"><thead><tr><th>Business Name</th><th>Contact Name</th><th>Projects</th><th>User Details</th><th>Time Sheet</th><th>Status</th><th></th></tr></thead><tbody>
<asp:Repeater ID="BusinessRows" runat="server" OnItemCommand="BusinessRows_ItemCommand"><ItemTemplate><tr><td><strong><%#: Eval("CompanyName") %></strong><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "Add_Business.aspx?BusinessIDEdit="+Eval("BusinessID") %>' Text="Edit Business" /></td><td><%#: Eval("PrimaryContactName") %></td><td><a href='<%# "Projects.aspx?BusinessId="+Eval("BusinessID") %>'>View Projects</a></td><td><strong><%#: Eval("Users") %> users</strong><div class="am-row-links"><a href='<%# "Users.aspx?BusinessId="+Eval("BusinessID") %>'>User List</a><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl="~/EmployeeEditor.aspx" Text="Add Employee" /><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "UserLoginAccess.aspx?BusinessId="+Eval("BusinessID") %>' Text="Login &amp; Access" /><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "GridviewNewDesign_AssignUser.aspx?BusinessIdFromDefaultPapge="+Eval("BusinessID") %>' Text="Assign User" /><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "GridviewNewDesign.aspx?BusinessIdFromDefaultPapge="+Eval("BusinessID") %>' Text="Assign User to Manager" /><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "AccountantAccess.aspx?BusinessId="+Eval("BusinessID") %>' Text="Accountant &amp; Payroll" /></div></td><td><a class="am-button secondary" href='<%# "WeekTimeCard.aspx?BusinessId="+Eval("BusinessID") %>'>&#9719; Open Time Card</a></td><td><span class='<%# "am-badge "+(Convert.ToString(Eval("Status")).Trim()=="1"?"Active":"Inactive") %>'><%#: Eval("DisplayStatus") %></span></td><td><asp:PlaceHolder runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>'><details class="am-menu am-business-status-menu"><summary aria-label='<%# "Change status for " + Eval("CompanyName") %>'>&#8942;</summary><div>
<asp:LinkButton runat="server" Text="Active" CommandName="SetBusinessStatus" CommandArgument='<%# Eval("BusinessID")+"|"+Eval("Status")+"|1" %>' Enabled='<%# Convert.ToString(Eval("Status")).Trim()!="1" %>' CausesValidation="false" />
<asp:LinkButton runat="server" Text="Not Active" CommandName="SetBusinessStatus" CommandArgument='<%# Eval("BusinessID")+"|"+Eval("Status")+"|0" %>' Enabled='<%# Convert.ToString(Eval("Status")).Trim()!="0" %>' CausesValidation="false" OnClientClick="return confirm('Mark this business Not Active? Its existing data will be retained.');" />
</div></details></asp:PlaceHolder></td></tr></ItemTemplate></asp:Repeater>
</tbody></table></div><asp:Label ID="Empty" runat="server" Visible="false" Text="No accessible businesses found." CssClass="am-notice" /></section>
</asp:PlaceHolder>
</asp:Content>
