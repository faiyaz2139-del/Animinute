<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="Dashboard.aspx.cs" Inherits="AnyminuteDashboard" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server" />
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="am-dashboard-overview"><div class="am-stats">
<div class="am-card am-stat"><span class="am-stat-icon" data-am-icon="business" aria-hidden="true"></span><div><small>Total Businesses</small><strong><asp:Literal ID="BusinessCount" runat="server" /></strong><small>Businesses you can access</small></div></div>
<div class="am-card am-stat"><span class="am-stat-icon" data-am-icon="people" aria-hidden="true"></span><div><small>Total Employees</small><strong><asp:Literal ID="EmployeeCount" runat="server" /></strong><small>Within your access</small></div></div>
<div class="am-card am-stat"><span class="am-stat-icon" data-am-icon="clock" aria-hidden="true"></span><div><small>Pending Approvals</small><strong><asp:Literal ID="ApprovalCount" runat="server" /></strong><small>Submitted timecards</small></div></div>
<div class="am-card am-stat"><span class="am-stat-icon" data-am-icon="folder" aria-hidden="true"></span><div><small>Active Projects</small><strong><asp:Literal ID="ProjectCount" runat="server" /></strong><small>Within your access</small></div></div>
</div>
</div>
<asp:Label ID="StatusMessage" runat="server" Visible="false" CssClass="am-notice" role="status" />
<section class="am-card" id="businesses"><div class="am-title am-businesses-header"><div><h1>Businesses</h1><p>Manage your businesses, projects, users and timecards.</p></div><section class="am-card am-quick-actions" aria-labelledby="quick-actions-title"><h2 id="quick-actions-title">Quick Actions</h2><div class="am-quick-grid">
<asp:HyperLink ID="AddBusiness" runat="server" NavigateUrl="~/Add_Business.aspx" CssClass="am-button secondary"><span data-am-icon="business" aria-hidden="true"></span>Add Business</asp:HyperLink>
<asp:HyperLink ID="AddUser" runat="server" NavigateUrl="~/Add_EmployeeV2.aspx" CssClass="am-button secondary"><span data-am-icon="people" aria-hidden="true"></span>Add Employee</asp:HyperLink>
<asp:HyperLink ID="ViewApprovals" runat="server" NavigateUrl="~/TimeCards.aspx?status=Submitted" CssClass="am-button secondary"><span data-am-icon="check" aria-hidden="true"></span>View Approvals</asp:HyperLink>
<asp:HyperLink ID="ReportsQuick" runat="server" Visible="false" CssClass="am-button secondary"><span data-am-icon="reports" aria-hidden="true"></span>Reports</asp:HyperLink>
</div></section></div>
<div class="am-toolbar"><label><span>Search businesses</span><input type="search" data-search="#business-grid" placeholder="Business or contact name&#8230;" /></label><label><span>Status</span><asp:DropDownList ID="StatusFilter" runat="server" AutoPostBack="true" OnSelectedIndexChanged="FilterChanged"><asp:ListItem Value="All">All statuses</asp:ListItem><asp:ListItem Value="Active">Active</asp:ListItem><asp:ListItem Value="Inactive">Not Active</asp:ListItem></asp:DropDownList></label></div>
<div class="am-table-wrap"><table class="am-table" id="business-grid"><thead><tr><th>Business Name</th><th>Contact Name</th><th>Projects</th><th>User Details</th><th>Time Sheet</th><th>Status</th><th></th></tr></thead><tbody>
<asp:Repeater ID="BusinessRows" runat="server" OnItemCommand="BusinessRows_ItemCommand"><ItemTemplate><tr><td><strong><%#: Eval("CompanyName") %></strong><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "Add_Business.aspx?BusinessIDEdit="+Eval("BusinessID") %>' Text="Edit Business" /></td><td><%#: Eval("PrimaryContactName") %></td><td><a href='<%# "Projects.aspx?BusinessId="+Eval("BusinessID") %>'>View Projects</a></td><td><strong><%#: Eval("Users") %> users</strong><div class="am-row-links"><a href='<%# "Users.aspx?BusinessId="+Eval("BusinessID") %>'>User List</a><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl="~/Add_EmployeeV2.aspx" Text="Add Employee" /><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "BusinessUsers.aspx?BusinessId="+Eval("BusinessID") %>' Text="Edit Employee" /><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "GridviewNewDesign_AssignUser.aspx?BusinessIdFromDefaultPapge="+Eval("BusinessID") %>' Text="Assign User" /><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "GridviewNewDesign.aspx?BusinessIdFromDefaultPapge="+Eval("BusinessID") %>' Text="Assign User to Manager" /><asp:HyperLink runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>' NavigateUrl='<%# "BusinessAccountant.aspx?BusinessId="+Eval("BusinessID") %>' Text="Assign Accountant" /></div></td><td><a class="am-button secondary" href='<%# "WeekTimeCard.aspx?BusinessId="+Eval("BusinessID") %>'>&#9719; Open Time Card</a></td><td><span class='<%# "am-badge "+(Convert.ToString(Eval("Status")).Trim()=="1"?"Active":"Inactive") %>'><%#: Eval("DisplayStatus") %></span></td><td><asp:PlaceHolder runat="server" Visible='<%# Convert.ToBoolean(Eval("Manage")) %>'><details class="am-menu am-business-status-menu"><summary aria-label='<%# "Change status for " + Eval("CompanyName") %>'>&#8942;</summary><div>
<asp:LinkButton runat="server" Text="Active" CommandName="SetBusinessStatus" CommandArgument='<%# Eval("BusinessID")+"|"+Eval("Status")+"|1" %>' Enabled='<%# Convert.ToString(Eval("Status")).Trim()!="1" %>' CausesValidation="false" />
<asp:LinkButton runat="server" Text="Not Active" CommandName="SetBusinessStatus" CommandArgument='<%# Eval("BusinessID")+"|"+Eval("Status")+"|0" %>' Enabled='<%# Convert.ToString(Eval("Status")).Trim()!="0" %>' CausesValidation="false" OnClientClick="return confirm('Mark this business Not Active? Its existing data will be retained.');" />
</div></details></asp:PlaceHolder></td></tr></ItemTemplate></asp:Repeater>
</tbody></table></div><asp:Label ID="Empty" runat="server" Visible="false" Text="No accessible businesses found." CssClass="am-notice" /></section>
</asp:Content>
