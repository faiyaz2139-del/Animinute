<%@ Page Language="C#" MasterPageFile="~/Modern.master" AutoEventWireup="true" CodeFile="EmployeeAssignment.aspx.cs" Inherits="AnyminuteEmployeeAssignmentPage" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link href="css/AnyminuteEmployees.css?v=20261024f1" rel="stylesheet" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><section class="am-card am-employees"><h1><asp:Literal ID="TitleText" runat="server" /></h1><div class="am-employee-info"><span class="am-employee-initials"><asp:Literal ID="PersonInitials" runat="server" /></span><strong><asp:Literal ID="Person" runat="server" /></strong><span><asp:Literal ID="PersonEmail" runat="server" /></span><span><asp:Literal ID="PersonPhone" runat="server" /></span><asp:Label ID="PersonStatus" runat="server" CssClass="am-badge" /></div><div class="am-employee-filters"><label>Business (required)<asp:DropDownList ID="Business" runat="server" AutoPostBack="true" OnSelectedIndexChanged="BusinessChanged" /></label><label>Role (required)<asp:DropDownList ID="Role" runat="server" /></label></div><p>Changes take effect now. Each business assignment uses one effective role in the current application.</p><p>Manage pay rates and projects from the employee profile after saving the assignment.</p><asp:Label ID="Message" runat="server" role="alert" /><div class="am-employee-actions"><asp:HyperLink ID="Cancel" runat="server" Text="Cancel" CssClass="am-button secondary" /><asp:Button runat="server" Text="Save Assignment" OnClick="Save_Click" CssClass="am-button" /></div>
<h2>Existing Business Assignments</h2><div class="am-table-wrap"><table class="am-table"><thead><tr><th>Business</th><th>Role</th><th>Employee Type</th><th>Pay Rate</th><th>Status</th><th>Action</th></tr></thead><tbody>
<asp:Repeater ID="Existing" runat="server"><ItemTemplate><tr><td><%#: Eval("Business") %></td><td><span class="am-role-chip"><%#: Eval("Role") %></span></td><td><%#: Eval("Type") %></td><td><%#: Eval("Rate") %></td><td><span class='<%# "am-badge " + (Convert.ToString(Eval("Status"))=="Active"?"Active":Convert.ToString(Eval("Status"))=="On Leave"?"OnLeave":"Inactive") %>'><%#: Eval("Status") %></span></td><td><a class="am-icon-action" title="Edit assignment" aria-label="Edit assignment" href='<%# "EmployeeAssignment.aspx?EmployeeId="+Eval("EmployeeId")+"&BusinessId="+Eval("BusinessId") %>'>&#9998;</a></td></tr></ItemTemplate></asp:Repeater>
</tbody></table></div></section></asp:Content>
