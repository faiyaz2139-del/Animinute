diff --git a/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteGeoIp.cs b/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteGeoIp.cs
new file mode 100644
index 0000000..7a4d037
--- /dev/null
+++ b/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteGeoIp.cs
@@ -0,0 +1,56 @@
+using System;
+using System.Collections.Generic;
+using System.Configuration;
+using System.IO;
+using System.Net;
+using System.Web;
+using System.Web.Caching;
+using System.Web.Script.Serialization;
+
+// 2026-10-28 v26 (Login Activity History "Location"): best-effort IP -> "City, Region, Country".
+// No paid service and no key: private / loopback addresses are labelled locally; public addresses are looked up only
+// when web.config has <add key="GeoIpLookupUrl" value="..."/> with an {ip} placeholder (any free JSON endpoint returning
+// city / region(_code|Name) / country(Code) fields, e.g. https://ipwho.is/{ip} or http://ip-api.com/json/{ip}).
+// Results are cached for a day; each page has a small time budget so the page never hangs on the lookup service.
+public static class AnyminuteGeoIp
+{
+    public const string NotConfigured = "\u0001";
+    public static bool Configured { get { return (ConfigurationManager.AppSettings["GeoIpLookupUrl"] ?? "").Contains("{ip}"); } }
+    public static string Local(string ip)
+    {
+        IPAddress a; if (String.IsNullOrEmpty(ip) || !IPAddress.TryParse(ip, out a)) return "";
+        if (IPAddress.IsLoopback(a)) return "This server (localhost)";
+        var b = a.GetAddressBytes();
+        if (b.Length == 4 && (b[0] == 10 || (b[0] == 172 && b[1] >= 16 && b[1] <= 31) || (b[0] == 192 && b[1] == 168) || (b[0] == 169 && b[1] == 254))) return "Private network";
+        if (b.Length == 16 && ((b[0] & 0xFE) == 0xFC || (b[0] == 0xFE && (b[1] & 0xC0) == 0x80))) return "Private network";
+        return null;
+    }
+    // Returns a location, "" when it cannot be resolved, or NotConfigured when no lookup URL is set.
+    public static string Locate(string ip, ref int budgetMs)
+    {
+        string local = Local(ip); if (local != null) return local;
+        object hit = HttpRuntime.Cache["am_geo_" + ip]; if (hit is string) return (string)hit;
+        if (!Configured) return NotConfigured;
+        if (budgetMs <= 0) return "";
+        var watch = System.Diagnostics.Stopwatch.StartNew(); string result = "";
+        try
+        {
+            var req = (HttpWebRequest)WebRequest.Create(ConfigurationManager.AppSettings["GeoIpLookupUrl"].Replace("{ip}", Uri.EscapeDataString(ip)));
+            req.Timeout = Math.Min(1500, budgetMs); req.ReadWriteTimeout = req.Timeout; req.UserAgent = "AnyMinute";
+            using (var resp = req.GetResponse()) using (var r = new StreamReader(resp.GetResponseStream()))
+            {
+                var d = new JavaScriptSerializer().Deserialize<Dictionary<string, object>>(r.ReadToEnd());
+                Func<string, string> g = k => d != null && d.ContainsKey(k) && d[k] != null ? Convert.ToString(d[k]).Trim() : "";
+                string city = g("city"), region = g("region_code"), country = g("country");
+                if (region.Length == 0) region = g("region").Length > 0 && g("region").Length <= 3 ? g("region") : (g("regionName").Length > 0 ? g("regionName") : g("region"));
+                if (country.Length == 0) country = g("countryCode").Length > 0 ? g("countryCode") : g("country_code");
+                var parts = new List<string>(); foreach (var p in new[] { city, region, country }) if (p.Length > 0 && !parts.Contains(p)) parts.Add(p);
+                result = String.Join(", ", parts);
+            }
+        }
+        catch (Exception) { result = ""; }
+        budgetMs -= (int)watch.ElapsedMilliseconds;
+        HttpRuntime.Cache.Insert("am_geo_" + ip, result, null, DateTime.UtcNow.AddHours(result.Length > 0 ? 24 : 1), Cache.NoSlidingExpiration);
+        return result;
+    }
+}
diff --git a/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminutePasswordReset.cs b/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminutePasswordReset.cs
new file mode 100644
index 0000000..2fee209
--- /dev/null
+++ b/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminutePasswordReset.cs
@@ -0,0 +1,61 @@
+using System;
+using System.Data;
+using System.Data.SqlClient;
+using System.Security.Cryptography;
+using System.Text;
+
+// 2026-10-28 v26 (Send Password Reset deck, strict): one-time reset links that expire after 24 hours.
+// The link is ResetUrl + EmployeeId + "&rt=" + token; only the SHA-256 hash of the token is stored
+// (AnyminutePasswordResetToken, REQUIRED_08). Issuing a new link cancels the user's earlier unused links.
+// ResetPassord.aspx validates the token, skips the temporary-password step, and consumes the token on success.
+public static class AnyminutePasswordReset
+{
+    public const int Hours = 24;
+    public static bool Ready(SqlConnection c) { return AnyminuteEmployeeEditor.HasTable(c, null, "AnyminutePasswordResetToken"); }
+    static string Hash(string token)
+    {
+        using (var sha = SHA256.Create())
+        {
+            var sb = new StringBuilder(); foreach (var b in sha.ComputeHash(Encoding.UTF8.GetBytes(token ?? ""))) sb.Append(b.ToString("x2")); return sb.ToString();
+        }
+    }
+    public static string Issue(SqlConnection c, SqlTransaction tx, int userId, int employeeId, string email, int createdBy)
+    {
+        var bytes = new byte[32]; using (var rng = new RNGCryptoServiceProvider()) rng.GetBytes(bytes);
+        string token = BitConverter.ToString(bytes).Replace("-", "").ToLowerInvariant();
+        AnyminuteTimesheetRepair.Execute(c, tx, "UPDATE AnyminutePasswordResetToken SET UsedAtUTC=SYSUTCDATETIME() WHERE UserId=@u AND UsedAtUTC IS NULL", "@u", userId);
+        AnyminuteTimesheetRepair.Execute(c, tx, "INSERT AnyminutePasswordResetToken(TokenHash,UserId,EmployeeId,Email,ExpiresAtUTC,CreatedBy) VALUES(@h,@u,@e,@m,DATEADD(hour,@x,SYSUTCDATETIME()),@b)",
+            "@h", Hash(token), "@u", userId, "@e", employeeId, "@m", email ?? "", "@x", Hours, "@b", createdBy);
+        return token;
+    }
+    // userId of a live (unused, unexpired) token for this employee id; 0 when invalid.
+    public static int Check(string empid, string token)
+    {
+        int e; if (String.IsNullOrEmpty(token) || token.Length != 64 || !Int32.TryParse(empid, out e)) return 0;
+        try
+        {
+            using (var c = AnyminuteTimesheetRepair.Open())
+            {
+                if (!Ready(c)) return 0;
+                var t = AnyminuteTimesheetRepair.Query(c, null, "SELECT UserId FROM AnyminutePasswordResetToken WHERE TokenHash=@h AND EmployeeId=@e AND UsedAtUTC IS NULL AND ExpiresAtUTC>SYSUTCDATETIME()", "@h", Hash(token), "@e", e);
+                return t.Rows.Count == 1 ? Convert.ToInt32(t.Rows[0][0]) : 0;
+            }
+        }
+        catch (Exception) { return 0; }
+    }
+    public static void Consume(string token, int userId)
+    {
+        try
+        {
+            using (var c = AnyminuteTimesheetRepair.Open())
+            {
+                AnyminuteTimesheetRepair.Execute(c, null, "UPDATE AnyminutePasswordResetToken SET UsedAtUTC=SYSUTCDATETIME() WHERE TokenHash=@h AND UsedAtUTC IS NULL", "@h", Hash(token));
+                if (AnyminuteEmployeeEditor.HasTable(c, null, "AnyminuteSupportAudit"))
+                    AnyminuteTimesheetRepair.Execute(c, null, @"INSERT AnyminuteSupportAudit(Entity,EntityKey,Action,ChangedBy,ChangedByName,Comments,IpAddress,Success)
+                        VALUES('Login',@k,'Password Changed',@u,'Subscriber','New password set from the one-time reset link.',@ip,1)",
+                        "@k", userId.ToString(System.Globalization.CultureInfo.InvariantCulture), "@u", userId, "@ip", System.Web.HttpContext.Current.Request.UserHostAddress ?? "");
+            }
+        }
+        catch (Exception) { }
+    }
+}
diff --git a/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteSessionGuard.cs b/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteSessionGuard.cs
new file mode 100644
index 0000000..ef913af
--- /dev/null
+++ b/AMV3Reseller_27Aug2022_Subscription/App_Code/AnyminuteSessionGuard.cs
@@ -0,0 +1,111 @@
+using System;
+using System.Data;
+using System.Data.SqlClient;
+using System.Globalization;
+using System.Web;
+using System.Web.Caching;
+
+// 2026-10-28 v26 (Support Admin deck 4, strict): active sessions + "Active sessions will be revoked immediately".
+// Login.aspx calls SignedIn(); Global.asax calls Check() on every request after session state is loaded.
+// A session is ended when its user has LoginDisabled=1 or SessionsRevokedAtUTC later than the session's sign-in.
+// Same-server revocations are seen on the very next request (HttpRuntime.Cache); the database is re-checked at most
+// once per minute per session (covers other servers / app pool recycles). Needs REQUIRED_08; without it nothing happens.
+public static class AnyminuteSessionGuard
+{
+    const string LoginKey = "am_login_utc", NextKey = "am_sg_next", UserKey = "am_sg_uid";
+    static bool ready; static DateTime checkedAt = DateTime.MinValue; static readonly object gate = new object();
+    public static bool Ready(SqlConnection c)
+    {
+        lock (gate) { if (DateTime.UtcNow - checkedAt < TimeSpan.FromMinutes(10)) return ready; }
+        bool ok = AnyminuteEmployeeEditor.HasTable(c, null, "AnyminuteActiveSession") && AnyminuteEmployeeEditor.HasColumn(c, null, "AnyminuteLoginSecurity", "SessionsRevokedAtUTC");
+        lock (gate) { ready = ok; checkedAt = DateTime.UtcNow; }
+        return ok;
+    }
+    static string Device(HttpRequest req)
+    {
+        string d = ""; try { d = req.Browser.Browser + " " + req.Browser.MajorVersion + " / " + AnyminuteSupportAdmin.Platform(req.UserAgent); } catch (Exception) { }
+        return d.Length > 200 ? d.Substring(0, 200) : d;
+    }
+    public static void SignedIn(string userId)
+    {
+        var h = HttpContext.Current; if (h == null || h.Session == null) return;
+        h.Session[LoginKey] = DateTime.UtcNow; h.Session[NextKey] = DateTime.UtcNow.AddSeconds(60);
+        int u; if (!Int32.TryParse(userId, out u)) return;
+        h.Session[UserKey] = u; // the account that signed in (Support "login as" switches Session["UserId"] but not this)
+        try
+        {
+            using (var c = AnyminuteTimesheetRepair.Open())
+            {
+                if (!Ready(c)) return;
+                AnyminuteTimesheetRepair.Execute(c, null, @"IF EXISTS(SELECT 1 FROM AnyminuteActiveSession WHERE SessionId=@s)
+                    UPDATE AnyminuteActiveSession SET UserId=@u,StartedAtUTC=SYSUTCDATETIME(),LastSeenAtUTC=SYSUTCDATETIME(),IpAddress=@ip,Device=@d,EndedAtUTC=NULL,EndReason=NULL WHERE SessionId=@s
+                    ELSE INSERT AnyminuteActiveSession(SessionId,UserId,IpAddress,Device) VALUES(@s,@u,@ip,@d)",
+                    "@s", h.Session.SessionID, "@u", u, "@ip", h.Request.UserHostAddress ?? "", "@d", Device(h.Request));
+            }
+        }
+        catch (Exception) { }
+    }
+    // Sign out from the masters: mark this session ended (never throws).
+    public static void SignedOut()
+    {
+        var h = HttpContext.Current; if (h == null || h.Session == null) return;
+        try { using (var c = AnyminuteTimesheetRepair.Open()) if (Ready(c)) AnyminuteTimesheetRepair.Execute(c, null, "UPDATE AnyminuteActiveSession SET EndedAtUTC=SYSUTCDATETIME(),EndReason='Signed out' WHERE SessionId=@s AND EndedAtUTC IS NULL", "@s", h.Session.SessionID); }
+        catch (Exception) { }
+    }
+    public static void Check(HttpContext h)
+    {
+        if (h == null || h.Session == null) return;
+        object who = h.Session[UserKey] ?? h.Session["UserId"]; if (who == null) return;
+        int u; if (!Int32.TryParse(Convert.ToString(who), out u)) return;
+        DateTime login = h.Session[LoginKey] is DateTime ? (DateTime)h.Session[LoginKey] : DateTime.MinValue;
+        object rev = HttpRuntime.Cache["am_rev_" + u];
+        bool revoked = rev is DateTime && (DateTime)rev > login;
+        if (!revoked)
+        {
+            DateTime next = h.Session[NextKey] is DateTime ? (DateTime)h.Session[NextKey] : DateTime.MinValue;
+            if (DateTime.UtcNow < next) return;
+            h.Session[NextKey] = DateTime.UtcNow.AddSeconds(60);
+            try
+            {
+                using (var c = AnyminuteTimesheetRepair.Open())
+                {
+                    if (!Ready(c)) return;
+                    var t = AnyminuteTimesheetRepair.Query(c, null, "SELECT LoginDisabled,SessionsRevokedAtUTC FROM AnyminuteLoginSecurity WHERE UserId=@u", "@u", u);
+                    if (t.Rows.Count == 1)
+                        revoked = Convert.ToBoolean(t.Rows[0]["LoginDisabled"]) || (t.Rows[0]["SessionsRevokedAtUTC"] != DBNull.Value && DateTime.SpecifyKind(Convert.ToDateTime(t.Rows[0]["SessionsRevokedAtUTC"]), DateTimeKind.Utc) > login);
+                    if (!revoked)
+                        AnyminuteTimesheetRepair.Execute(c, null, @"IF EXISTS(SELECT 1 FROM AnyminuteActiveSession WHERE SessionId=@s)
+                            UPDATE AnyminuteActiveSession SET LastSeenAtUTC=SYSUTCDATETIME() WHERE SessionId=@s AND EndedAtUTC IS NULL
+                            ELSE INSERT AnyminuteActiveSession(SessionId,UserId,IpAddress,Device) VALUES(@s,@u,@ip,@d)",
+                            "@s", h.Session.SessionID, "@u", u, "@ip", h.Request.UserHostAddress ?? "", "@d", Device(h.Request));
+                }
+            }
+            catch (Exception) { return; }
+        }
+        if (!revoked) return;
+        try { using (var c = AnyminuteTimesheetRepair.Open()) AnyminuteTimesheetRepair.Execute(c, null, "UPDATE AnyminuteActiveSession SET EndedAtUTC=ISNULL(EndedAtUTC,SYSUTCDATETIME()),EndReason=ISNULL(EndReason,'Revoked') WHERE SessionId=@s", "@s", h.Session.SessionID); }
+        catch (Exception) { }
+        h.Session.Clear(); h.Session.Abandon();
+        if (h.Request.Path.EndsWith("/Login.aspx", StringComparison.OrdinalIgnoreCase)) return;
+        h.Response.Redirect(VirtualPathUtility.ToAbsolute("~/Login.aspx") + "?revoked=1", false);
+        h.ApplicationInstance.CompleteRequest();
+    }
+    // Support Admin "Disable Login Access": end every live session of the user (call inside the save transaction).
+    public static int Revoke(SqlConnection c, SqlTransaction tx, int userId, string reason)
+    {
+        if (!Ready(c)) return -1;
+        AnyminuteTimesheetRepair.Execute(c, tx, "UPDATE AnyminuteLoginSecurity SET SessionsRevokedAtUTC=SYSUTCDATETIME() WHERE UserId=@u", "@u", userId);
+        var n = AnyminuteTimesheetRepair.Query(c, tx, @"UPDATE AnyminuteActiveSession SET EndedAtUTC=SYSUTCDATETIME(),EndReason=@r WHERE UserId=@u AND EndedAtUTC IS NULL AND LastSeenAtUTC>DATEADD(minute,-@t,SYSUTCDATETIME()); SELECT @@ROWCOUNT",
+            "@u", userId, "@r", reason.Length > 100 ? reason.Substring(0, 100) : reason, "@t", Timeout());
+        return Convert.ToInt32(n.Rows[0][0]);
+    }
+    // After the transaction commits: same-server sessions see the revocation on their next request.
+    public static void Revoked(int userId) { HttpRuntime.Cache.Insert("am_rev_" + userId, DateTime.UtcNow, null, DateTime.UtcNow.AddHours(12), Cache.NoSlidingExpiration); }
+    public static int Timeout() { var h = HttpContext.Current; return h != null && h.Session != null ? h.Session.Timeout : 20; }
+    // Live sessions = not ended and seen within the session timeout. Returns -1 when REQUIRED_08 is missing.
+    public static DataTable Active(SqlConnection c, int userId)
+    {
+        if (!Ready(c)) return null;
+        return AnyminuteTimesheetRepair.Query(c, null, "SELECT SessionId,StartedAtUTC,LastSeenAtUTC,IpAddress,Device FROM AnyminuteActiveSession WHERE UserId=@u AND EndedAtUTC IS NULL AND LastSeenAtUTC>DATEADD(minute,-@t,SYSUTCDATETIME()) ORDER BY LastSeenAtUTC DESC", "@u", userId, "@t", Timeout());
+    }
+}
